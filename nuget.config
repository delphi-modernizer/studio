<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The engine's packages; needs a token with read:packages (docs/BUILDING.md). -->
    <add key="delphi-modernizer" value="https://nuget.pkg.github.com/delphi-modernizer/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="delphi-modernizer">
      <package pattern="DelphiModernizer.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
