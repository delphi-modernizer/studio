<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drives the built app through UI Automation and captures every page (docs/design/ui-screenshots.md). It is a
    console tool, not a test project, so dotnet test skips it; EnableWindowsTargeting lets Linux build it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

</Project>
