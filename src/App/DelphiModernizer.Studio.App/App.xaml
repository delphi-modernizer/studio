<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="DelphiModernizer.Studio.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Application.Resources is the one scope every module's pages see; ms-appx:///<assembly>/ reaches another assembly's file.  -->
                <ResourceDictionary Source="ms-appx:///DelphiModernizer.Studio.UI.Common/Styles/Studio.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Every icon comes from the app's own font (docs/icons.md); its glyphs are the StudioIcons constants.  -->
            <FontFamily x:Key="StudioIconsFontFamily">ms-appx:///Assets/Fonts/StudioIcons.ttf#Studio Icons</FontFamily>
            <Style x:Key="IconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource StudioIconsFontFamily}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
