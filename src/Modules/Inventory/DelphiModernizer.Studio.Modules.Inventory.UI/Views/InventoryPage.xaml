<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Inventory.UI.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.Inventory.UI.ViewModels"
    Loaded="OnLoaded">

    <Page.Resources>
        <Style
            x:Key="NumberCellStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="NumberHeaderStyle"
            BasedOn="{StaticResource TableHeaderTextStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="LinkStyle" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <controls:PageHeader Purpose="What the scanner found in legacy/. Findings to confirm, not compiler output." Title="Inventory">
                <controls:PageHeader.Actions>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasWorkspace, Mode=OneWay}">
                        <Button Click="OnOpenMarkdown" IsEnabled="{x:Bind ViewModel.IsScanned, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind icons:StudioIcons.Deliverables}" Style="{StaticResource IconStyle}" />
                                <TextBlock Text="Open inventory.md" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ScanCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind icons:StudioIcons.Refresh}" Style="{StaticResource IconStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ScanLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <controls:NoWorkspaceState
                Glyph="{x:Bind icons:StudioIcons.Inventory}"
                Message="The inventory lists what the scanner found in a workspace’s legacy/ folder: code modules, screens, database access, SQL and risks. Open or start a workspace to see it."
                Visibility="{x:Bind ViewModel.HasNoWorkspace, Mode=OneWay}" />

            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasWorkspace, Mode=OneWay}">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                    Severity="Error"
                    Title="The scan didn’t finish.">
                    <InfoBar.IconSource>
                        <FontIconSource FontFamily="{StaticResource StudioIconsFontFamily}" Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                    </InfoBar.IconSource>
                </InfoBar>

                <Border
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Scanning legacy/…" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" />
                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="The scan only reads legacy/. Results replace the previous inventory when it finishes." />
                    </StackPanel>
                </Border>

                <ItemsRepeater AutomationProperties.Name="Summary" ItemsSource="{x:Bind ViewModel.Stats, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MaximumRowsOrColumns="4"
                            MinColumnSpacing="16"
                            MinItemWidth="160"
                            MinRowSpacing="16"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:InventoryStat">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind Glyph}"
                                            Style="{StaticResource IconStyle}" />
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Label}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Number}" />
                                        <TextBlock
                                            Margin="0,0,0,5"
                                            VerticalAlignment="Bottom"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Unit}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Detail}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsNotScanned, Mode=OneWay}">
                    <controls:EmptyState
                        Glyph="{x:Bind icons:StudioIcons.Discover}"
                        Message="The scan reads every .pas, .dfm, .dpr and project file and lists code modules, screens, database access, SQL and risks. It never changes legacy/. With Claude Code, the Legacy discovery agent can then draft D02 from it."
                        Title="legacy/ hasn’t been scanned">
                        <Button Command="{x:Bind ViewModel.ScanCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind icons:StudioIcons.Refresh}" Style="{StaticResource IconStyle}" />
                                <TextBlock Text="Scan legacy/" />
                            </StackPanel>
                        </Button>
                    </controls:EmptyState>
                </Border>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsScanned, Mode=OneWay}">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind ViewModel.Facts, Mode=OneWay}" />
                    <SelectorBar
                        x:Name="TabBar"
                        AutomationProperties.Name="Inventory sections"
                        SelectionChanged="OnTabChanged" />

                    <!--  Code modules.  -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsUnits, Mode=OneWay}">
                        <TextBox
                            Width="320"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Search code modules"
                            PlaceholderText="Search code modules and paths"
                            Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.IsLarge, Mode=OneWay}" />
                        <Border Style="{StaticResource FlushCardStyle}">
                            <StackPanel AutomationProperties.Name="Code modules">
                                <Grid Style="{StaticResource TableHeaderStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Code module and path" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Code lines" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Routines" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Globals" />
                                    <TextBlock
                                        Grid.Column="4"
                                        AutomationProperties.Name="Fan-in, sorted descending"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Fan-in" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Fan-out" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Uses" />
                                    <TextBlock
                                        Grid.Column="7"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Types" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:UnitRow">
                                            <Grid AutomationProperties.Name="{x:Bind AnnouncedName}">
                                                <Grid
                                                    MinHeight="36"
                                                    Padding="16,6"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    ColumnSpacing="8"
                                                    Visibility="{x:Bind IsFolder}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind Name}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind Path}" />
                                                </Grid>
                                                <Grid
                                                    MinHeight="44"
                                                    Padding="16,6"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    ColumnSpacing="12"
                                                    Visibility="{x:Bind IsUnit}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                                            <controls:StatusPill
                                                                State="Warning"
                                                                Text="Cycle"
                                                                Visibility="{x:Bind InCycle}" />
                                                            <Border Style="{StaticResource TagStyle}" Visibility="{x:Bind IsProgram}">
                                                                <TextBlock
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="main program"
                                                                    TextLineBounds="Tight" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource MonoTextStyle}" Text="{x:Bind Path}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource NumberCellStyle}"
                                                        Text="{x:Bind CodeLines}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Style="{StaticResource NumberCellStyle}"
                                                        Text="{x:Bind Routines.ToString()}" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Style="{StaticResource NumberCellStyle}"
                                                        Text="{x:Bind Globals.ToString()}" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Style="{StaticResource NumberCellStyle}"
                                                        Text="{x:Bind FanIn.ToString()}" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        Style="{StaticResource NumberCellStyle}"
                                                        Text="{x:Bind FanOut.ToString()}" />
                                                    <TextBlock
                                                        Grid.Column="6"
                                                        Style="{StaticResource NumberCellStyle}"
                                                        Text="{x:Bind Uses.ToString()}" />
                                                    <TextBlock
                                                        Grid.Column="7"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MonoTextStyle}"
                                                        Text="{x:Bind Types}" />
                                                    <Button
                                                        Grid.Column="8"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind OpenName}"
                                                        Click="OnLinkClicked"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Tag="{x:Bind Path}"
                                                        ToolTipService.ToolTip="Open in your editor">
                                                        <FontIcon Glyph="{x:Bind icons:StudioIcons.OpenInEditor}" Style="{StaticResource IconStyle}" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.UnitsNote, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Screens and the controls on them.  -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsScreens, Mode=OneWay}">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasUnreadable, Mode=OneWay}"
                            Message="{x:Bind ViewModel.Unreadable, Mode=OneWay}"
                            Severity="Warning"
                            Title="Some screens can’t be read.">
                            <InfoBar.IconSource>
                                <FontIconSource FontFamily="{StaticResource StudioIconsFontFamily}" Glyph="{x:Bind icons:StudioIcons.WarningFilled}" />
                            </InfoBar.IconSource>
                        </InfoBar>
                        <Border Style="{StaticResource FlushCardStyle}">
                            <StackPanel AutomationProperties.Name="Screens">
                                <Grid Style="{StaticResource TableHeaderStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Screen and its file" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Format" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Controls" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Events" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Screens, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScreenRow">
                                            <Grid
                                                MinHeight="44"
                                                Padding="16,6"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="32" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Root}" />
                                                    <TextBlock Style="{StaticResource MonoTextStyle}" Text="{x:Bind Path}" />
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="1"
                                                    Style="{StaticResource TagStyle}">
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Format}"
                                                        TextLineBounds="Tight" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Style="{StaticResource NumberCellStyle}"
                                                    Text="{x:Bind Controls.ToString()}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Style="{StaticResource NumberCellStyle}"
                                                    Text="{x:Bind Events.ToString()}" />
                                                <Button
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind OpenName}"
                                                    Click="OnLinkClicked"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind Path}"
                                                    ToolTipService.ToolTip="Open in your editor">
                                                    <FontIcon Glyph="{x:Bind icons:StudioIcons.OpenInEditor}" Style="{StaticResource IconStyle}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlushCardStyle}">
                            <StackPanel AutomationProperties.Name="Controls">
                                <Grid Style="{StaticResource TableHeaderStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Control type" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource NumberHeaderStyle}"
                                        Text="Count" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Vendor" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Category" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Controls, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ControlRow">
                                            <Grid
                                                MinHeight="36"
                                                Padding="16,6"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Style="{StaticResource MonoTextStyle}"
                                                    Text="{x:Bind ClassName}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource NumberCellStyle}"
                                                    Text="{x:Bind Count.ToString()}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind Vendor}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Category}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Data access, connections, libraries and external routines.  -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsData, Mode=OneWay}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Technologies, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="2"
                                    MinColumnSpacing="16"
                                    MinItemWidth="280"
                                    MinRowSpacing="16"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:TechnologyCard">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{x:Bind icons:StudioIcons.Components}"
                                                    Style="{StaticResource IconStyle}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    AutomationProperties.HeadingLevel="Level2"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Name}" />
                                                <Border Grid.Column="2" Style="{StaticResource TagStyle}">
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Category}"
                                                        TextLineBounds="Tight" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind Places}" />
                                            </Grid>
                                            <ItemsRepeater ItemsSource="{x:Bind Evidence}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:Place">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <HyperlinkButton
                                                                Click="OnLinkClicked"
                                                                Content="{x:Bind Link}"
                                                                Style="{StaticResource LinkStyle}"
                                                                Tag="{x:Bind Link}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                                Text="{x:Bind Detail}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="2"
                                    MinColumnSpacing="16"
                                    MinItemWidth="280"
                                    MinRowSpacing="16"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionCard">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{x:Bind icons:StudioIcons.Connection}"
                                                    Style="{StaticResource IconStyle}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    AutomationProperties.HeadingLevel="Level2"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Name}" />
                                                <controls:StatusPill
                                                    Grid.Column="2"
                                                    State="Error"
                                                    Text="Embedded password"
                                                    Visibility="{x:Bind HasEmbeddedPassword}" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind Meta}" />
                                                <HyperlinkButton
                                                    Click="OnLinkClicked"
                                                    Content="{x:Bind Link}"
                                                    Style="{StaticResource LinkStyle}"
                                                    Tag="{x:Bind Link}" />
                                            </StackPanel>
                                            <ItemsRepeater ItemsSource="{x:Bind Settings}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:Setting">
                                                        <Grid AutomationProperties.Name="{x:Bind AnnouncedName}" ColumnSpacing="16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="128" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Key}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Style="{StaticResource MonoTextStyle}"
                                                                Text="{x:Bind Value}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Secrets found in legacy code always show as ***. The studio has no control to reveal them." />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind icons:StudioIcons.ExternalRoutines}"
                                        Style="{StaticResource IconStyle}" />
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="External routines and COM" />
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Externals, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExternalRow">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Style="{StaticResource MonoTextStyle}"
                                                    Text="{x:Bind Routine}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind Library}" />
                                                <HyperlinkButton
                                                    Click="OnLinkClicked"
                                                    Content="{x:Bind Link}"
                                                    Style="{StaticResource LinkStyle}"
                                                    Tag="{x:Bind Link}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.ComNote, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  SQL statements and risk markers.  -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsRisks, Mode=OneWay}">
                        <Border Style="{StaticResource FlushCardStyle}">
                            <StackPanel AutomationProperties.Name="SQL statements">
                                <TextBlock
                                    Padding="16,12,16,8"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="SQL statements" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sql, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SqlRow">
                                            <Grid
                                                MinHeight="44"
                                                Padding="16,6"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <HyperlinkButton
                                                    Click="OnLinkClicked"
                                                    Content="{x:Bind Link}"
                                                    Style="{StaticResource LinkStyle}"
                                                    Tag="{x:Bind Link}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Kind}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Style="{StaticResource MonoTextStyle}"
                                                    Text="{x:Bind Text}"
                                                    ToolTipService.ToolTip="{x:Bind Text}" />
                                                <StackPanel
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind Note}" />
                                                    <controls:StatusPill
                                                        State="Error"
                                                        Text="Built by concatenation"
                                                        Visibility="{x:Bind BuiltByConcatenation}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FlushCardStyle}">
                            <StackPanel AutomationProperties.Name="Risk markers">
                                <TextBlock
                                    Padding="16,12,16,8"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Risk markers" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Risks, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RiskRow">
                                            <Grid
                                                MinHeight="34"
                                                Padding="16,4"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Kind}" />
                                                <HyperlinkButton
                                                    Grid.Column="1"
                                                    Click="OnLinkClicked"
                                                    Content="{x:Bind Link}"
                                                    Style="{StaticResource LinkStyle}"
                                                    Tag="{x:Bind Link}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Style="{StaticResource NumberCellStyle}"
                                                    Text="{x:Bind Count.ToString()}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MonoTextStyle}"
                                                    Text="{x:Bind Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Circular dependencies.  -->
                    <Border Style="{StaticResource FlushCardStyle}" Visibility="{x:Bind ViewModel.IsCycles, Mode=OneWay}">
                        <ItemsRepeater AutomationProperties.Name="Cycles" ItemsSource="{x:Bind ViewModel.Cycles, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CycleRow">
                                    <StackPanel
                                        Padding="16,10"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="{x:Bind icons:StudioIcons.Cycle}"
                                            Style="{StaticResource IconStyle}" />
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Units}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>

                    <!--  What the scanner could not read.  -->
                    <Border Style="{StaticResource FlushCardStyle}" Visibility="{x:Bind ViewModel.IsDiagnostics, Mode=OneWay}">
                        <ItemsRepeater AutomationProperties.Name="Diagnostics" ItemsSource="{x:Bind ViewModel.Diagnostics, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticRow">
                                    <Grid
                                        Padding="16,8"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind icons:StudioIcons.Diagnostics}"
                                            Style="{StaticResource IconStyle}" />
                                        <HyperlinkButton
                                            Grid.Column="1"
                                            Click="OnLinkClicked"
                                            Content="{x:Bind Link}"
                                            Style="{StaticResource LinkStyle}"
                                            Tag="{x:Bind Link}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind Message}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
