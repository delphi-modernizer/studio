<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Workstreams.UI.Views.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:local="using:DelphiModernizer.Studio.Modules.Workstreams.UI.Views"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.Workstreams.UI.ViewModels">

    <Page.Resources>
        <!--  Every item has a divider above it, as drawn; the list item's own border isn't drawn.  -->
        <Style x:Key="TranscriptItemStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style
            x:Key="ToolNameStyle"
            BasedOn="{StaticResource MonoTextStyle}"
            TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <!--  The stroke keeps the box visible in high contrast, where the subtle fill is transparent.  -->
        <Style x:Key="ResultStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!--  One transcript item per row, divided as the design draws them; the templates carry the padding.  -->
        <Style
            x:Key="TranscriptItemContainerStyle"
            BasedOn="{StaticResource TableRowStyle}"
            TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style
            x:Key="ResultTextStyle"
            BasedOn="{StaticResource MonoTextStyle}"
            TargetType="TextBlock">
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>

        <DataTemplate x:Key="SessionTemplate" x:DataType="vm:SessionRow">
            <Grid AutomationProperties.Name="{x:Bind AnnouncedName}" Style="{StaticResource TranscriptItemStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    Glyph="{x:Bind icons:StudioIcons.ClaudeCode}"
                    Style="{StaticResource IconStyle}" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Session" />
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AgentTemplate" x:DataType="vm:AgentRow">
            <Grid AutomationProperties.Name="{x:Bind AnnouncedName}" Style="{StaticResource TranscriptItemStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    Glyph="{x:Bind icons:StudioIcons.Agent}"
                    Style="{StaticResource IconStyle}" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Who}" />
                    <ItemsRepeater ItemsSource="{x:Bind Lines}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AgentLineRow">
                                <StackPanel Spacing="6">
                                    <!--  The fact label sits inline after the claim, on its baseline.  -->
                                    <RichTextBlock
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource BodyRichTextBlockStyle}">
                                        <Paragraph>
                                            <Run Text="{x:Bind Claim}" />
                                            <InlineUIContainer>
                                                <controls:FactLabel
                                                    Margin="6,0,0,-4"
                                                    Kind="{x:Bind Kind}"
                                                    Visibility="{x:Bind HasLabel}" />
                                            </InlineUIContainer>
                                        </Paragraph>
                                    </RichTextBlock>
                                    <!--  Tab from the focused item reaches these links.  -->
                                    <ItemsRepeater
                                        ItemsSource="{x:Bind Evidence}"
                                        Visibility="{x:Bind HasEvidence}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <controls:EvidenceLink Reference="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ToolTemplate" x:DataType="vm:ToolRow">
            <Grid
                AutomationProperties.Name="{x:Bind AnnouncedName, Mode=OneWay}"
                Style="{StaticResource TranscriptItemStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    Glyph="{x:Bind icons:StudioIcons.ToolCall}"
                    Style="{StaticResource IconStyle}" />
                <!--  The transcript list's item is the toggle: Enter, Space or a click expands it.  -->
                <StackPanel Grid.Column="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ToolNameStyle}" Text="{x:Bind Name}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MonoTextStyle}"
                            Text="{x:Bind Input}"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="{x:Bind Summary, Mode=OneWay}" />
                        <FontIcon
                            Grid.Column="3"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind Chevron, Mode=OneWay}"
                            Style="{StaticResource IconStyle}" />
                    </Grid>
                    <Border Style="{StaticResource ResultStyle}" Visibility="{x:Bind ShowsResult, Mode=OneWay}">
                        <TextBlock Style="{StaticResource ResultTextStyle}" Text="{x:Bind Result, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RefusalTemplate" x:DataType="vm:RefusalRow">
            <Grid
                AutomationProperties.Name="{x:Bind AnnouncedName}"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                Style="{StaticResource TranscriptItemStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    Glyph="{x:Bind icons:StudioIcons.GuardRefused}"
                    Style="{StaticResource IconStyle}" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ToolNameStyle}" Text="{x:Bind Name}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MonoTextStyle}"
                            Text="{x:Bind Input}"
                            TextWrapping="NoWrap" />
                        <!--  The canvas's filled warning pill (.pill.warn), with the guard's icon.  -->
                        <Border
                            Grid.Column="2"
                            Height="20"
                            Padding="6,0,8,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource StatusPillCautionBackground}"
                            BorderBrush="{ThemeResource StatusPillToneOutline}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource StatusPillCautionGlyph}"
                                    Glyph="{x:Bind icons:StudioIcons.GuardRefused}"
                                    Style="{StaticResource IconStyle}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Refused by the guard"
                                    TextLineBounds="Tight" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Outcome}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DiagnosticTemplate" x:DataType="vm:DiagnosticRow">
            <Grid AutomationProperties.Name="{x:Bind AnnouncedName}" Style="{StaticResource TranscriptItemStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind icons:StudioIcons.Diagnostics}"
                    Style="{StaticResource IconStyle}" />
                <Border
                    Grid.Column="1"
                    Margin="0"
                    Style="{StaticResource ResultStyle}">
                    <TextBlock Style="{StaticResource ResultTextStyle}" Text="{x:Bind Text}" />
                </Border>
            </Grid>
        </DataTemplate>

        <local:TranscriptTemplates
            x:Key="TranscriptTemplates"
            Agent="{StaticResource AgentTemplate}"
            Diagnostic="{StaticResource DiagnosticTemplate}"
            Refusal="{StaticResource RefusalTemplate}"
            Session="{StaticResource SessionTemplate}"
            Tool="{StaticResource ToolTemplate}" />
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!--  Under 1100 the strip keeps Model, Claude Code and Cost; the side cards go below in 3 columns.  -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Spacing" Value="16" />
                        <Setter Target="TurnsColumn.Width" Value="0" />
                        <Setter Target="TimeColumn.Width" Value="0" />
                        <Setter Target="TurnsCell.Visibility" Value="Collapsed" />
                        <Setter Target="TimeCell.Visibility" Value="Collapsed" />
                        <Setter Target="RunGrid.ColumnSpacing" Value="0" />
                        <Setter Target="RunGrid.RowSpacing" Value="16" />
                        <Setter Target="SideColumn.Width" Value="0" />
                        <Setter Target="SideCards.(Grid.Row)" Value="1" />
                        <Setter Target="SideCards.(Grid.Column)" Value="0" />
                        <Setter Target="SideCards.ColumnSpacing" Value="12" />
                        <Setter Target="SideCards.RowSpacing" Value="0" />
                        <Setter Target="FilesColumn.Width" Value="*" />
                        <Setter Target="GuardColumn.Width" Value="*" />
                        <Setter Target="FilesCard.(Grid.Row)" Value="0" />
                        <Setter Target="FilesCard.(Grid.Column)" Value="1" />
                        <Setter Target="GuardCard.(Grid.Row)" Value="0" />
                        <Setter Target="GuardCard.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <controls:FullWidthStackPanel x:Name="PageContent" Style="{StaticResource PageContentStyle}">
                <StackPanel
                    AutomationProperties.Name="Breadcrumb"
                    Orientation="Horizontal"
                    Spacing="4">
                    <HyperlinkButton
                        MinHeight="0"
                        Padding="0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Click="OnOpenWorkstreams"
                        Content="Workstreams" />
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                        Style="{StaticResource IconStyle}" />
                    <HyperlinkButton
                        MinHeight="0"
                        Padding="0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Click="OnOpenRole"
                        Content="{x:Bind ViewModel.RoleName, Mode=OneWay}" />
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                        Style="{StaticResource IconStyle}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Run" />
                </StackPanel>

                <Grid Margin="0,-12,0,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level1"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                            <controls:StatusPill
                                x:Name="Pill"
                                AutomationProperties.LiveSetting="Polite"
                                State="{x:Bind ViewModel.Pill, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap">
                            <!--  XAML puts one space between these runs.  -->
                            <Run Text="{x:Bind ViewModel.SubtitleStart, Mode=OneWay}" />
                            <Run
                                FontFamily="Cascadia Mono,Consolas"
                                FontSize="13"
                                Text="{x:Bind ViewModel.SubtitleCode, Mode=OneWay}" />
                            <Run Text="{x:Bind ViewModel.SubtitleEnd, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Click="OnStop" Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind icons:StudioIcons.Stop}" Style="{StaticResource IconStyle}" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                        <Button
                            Click="OnOpenRole"
                            Content="{x:Bind ViewModel.BackText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsEnded, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsFailed, Mode=OneWay}"
                    Message="{x:Bind local:RunPage.FailedText(ViewModel.FailureMessage), Mode=OneWay}"
                    Severity="Error"
                    Title="The run failed."
                    Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}">
                    <InfoBar.IconSource>
                        <FontIconSource
                            FontFamily="{StaticResource StudioIconsFontFamily}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                    </InfoBar.IconSource>
                    <InfoBar.ActionButton>
                        <Button Click="OnRunAgain" Content="Run again…" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                    Severity="Error"
                    Title="Couldn’t show or start the run."
                    Visibility="{x:Bind ViewModel.HasProblem, Mode=OneWay}">
                    <InfoBar.IconSource>
                        <FontIconSource
                            FontFamily="{StaticResource StudioIconsFontFamily}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                    </InfoBar.IconSource>
                </InfoBar>

                <Border AutomationProperties.Name="Session" Style="{StaticResource FlushCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="TurnsColumn" Width="*" />
                            <ColumnDefinition x:Name="TimeColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  The values read at body size, the design's mono at 0.92em; the captions stay small.  -->
                        <StackPanel Padding="16,10" Spacing="2">
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Model" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                LineHeight="20"
                                Style="{StaticResource MonoTextStyle}"
                                Text="{x:Bind ViewModel.Model, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Padding="16,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Claude Code" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                LineHeight="20"
                                Style="{StaticResource MonoTextStyle}"
                                Text="{x:Bind ViewModel.CliVersion, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Padding="16,10"
                            AutomationProperties.Name="{x:Bind local:RunPage.CostName(ViewModel.Cost), Mode=OneWay}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Cost" />
                            <TextBlock Text="{x:Bind ViewModel.Cost, Mode=OneWay}" />
                            <ProgressBar Margin="0,4,0,0" Value="{x:Bind ViewModel.CostPercent, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            x:Name="TurnsCell"
                            Grid.Column="3"
                            Padding="16,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Spacing="2">
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Turns" />
                            <TextBlock Text="{x:Bind ViewModel.Turns, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            x:Name="TimeCell"
                            Grid.Column="4"
                            Padding="16,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            Spacing="2">
                            <TextBlock
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="{x:Bind ViewModel.TimeLabel, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Time, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="EndCard"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind ViewModel.EndTitle, Mode=OneWay}"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsEnded, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:StatusPill State="{x:Bind ViewModel.Pill, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.EndTitle, Mode=OneWay}" />
                        </StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Cost" />
                                <TextBlock Text="{x:Bind ViewModel.Spent, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Duration" />
                                <TextBlock Text="{x:Bind ViewModel.Time, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Turns" />
                                <TextBlock Text="{x:Bind ViewModel.Turns, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="Permission denials" />
                                <TextBlock Text="{x:Bind ViewModel.Denials, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.EndText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="OnOpenDraft"
                                Style="{x:Bind local:RunPage.DraftStyle(ViewModel.Outcome), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        Glyph="{x:Bind icons:StudioIcons.Deliverables}"
                                        Style="{StaticResource IconStyle}" />
                                    <TextBlock Text="Open the draft" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenRole" Content="{x:Bind ViewModel.BackText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid x:Name="RunGrid" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SideColumn" Width="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border VerticalAlignment="Top" Style="{StaticResource FlushCardStyle}">
                        <StackPanel>
                            <Grid BorderThickness="0" Style="{StaticResource CardHeaderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Transcript" />
                                <HyperlinkButton
                                    Grid.Column="1"
                                    Click="OnExpandAll"
                                    Content="{x:Bind ViewModel.ExpandAllText, Mode=OneWay}" />
                            </Grid>
                            <!--  One tab stop with arrows by item; no live setting, so new items are not read out.  -->
                            <ListView
                                AutomationProperties.Name="Transcript"
                                IsItemClickEnabled="True"
                                ItemClick="OnTranscriptItemClick"
                                ItemContainerStyle="{StaticResource TranscriptItemContainerStyle}"
                                ItemTemplateSelector="{StaticResource TranscriptTemplates}"
                                ItemsSource="{x:Bind ViewModel.Items}"
                                SelectionMode="None" />
                            <Grid
                                Style="{StaticResource TranscriptItemStyle}"
                                Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Spinner
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsActive="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsStarting, Mode=OneWay}">
                                    <TextBlock Text="Starting Claude Code…" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.StartingText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="Working…"
                                    Visibility="{x:Bind local:RunPage.Not(ViewModel.IsStarting), Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid
                        x:Name="SideCards"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="FilesColumn" Width="Auto" />
                            <ColumnDefinition x:Name="GuardColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border VerticalAlignment="Top" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Writes" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Writes, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WriteRow">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{x:Bind icons:StudioIcons.Deliverables}"
                                                    Style="{StaticResource IconStyle}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind ViewModel.WritesNote, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="FilesCard"
                            Grid.Row="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Files touched" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind local:RunPage.NoFilesText(ViewModel.IsLive), Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HasNoFiles, Mode=OneWay}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Files}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FileRow">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                                                    Style="{StaticResource IconStyle}" />
                                                <!--  Edited files in primary text, as drawn.  -->
                                                <controls:PathText
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Text="{x:Bind Path}"
                                                    Visibility="{x:Bind IsEdited, Mode=OneWay}" />
                                                <controls:PathText
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Path}"
                                                    Visibility="{x:Bind local:RunPage.Not(IsEdited), Mode=OneWay}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Padding="6"
                                                    AutomationProperties.Name="{x:Bind local:RunPage.OpenName(Name)}"
                                                    Click="OnOpenFile"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Tag="{x:Bind}">
                                                    <FontIcon
                                                        Glyph="{x:Bind icons:StudioIcons.OpenInEditor}"
                                                        Style="{StaticResource IconStyle}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="GuardCard"
                            Grid.Row="2"
                            VerticalAlignment="Top"
                            Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind icons:StudioIcons.GuardRefused}"
                                        Style="{StaticResource IconStyle}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Guard" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.GuardCount, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}">
                                    Agents edit docs/ only. Refusals appear in the transcript and the run carries on.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </controls:FullWidthStackPanel>
        </ScrollViewer>
    </Grid>
</Page>
