<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Workstreams.UI.Views.WorkstreamsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.Workstreams.UI.ViewModels"
    Loaded="OnLoaded">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <controls:PageHeader Purpose="The Principal Architect and six teams: what each one drafts, and the tasks its agent can run." Title="Workstreams" />
            <controls:NoWorkspaceState
                Glyph="{x:Bind icons:StudioIcons.Workstreams}"
                Message="Workstreams shows a workspace’s Principal Architect and six teams: what each one drafts, and the tasks its agent can run. Open or start a workspace to see them."
                Visibility="{x:Bind ViewModel.HasNoWorkspace, Mode=OneWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasNoClaude, Mode=OneWay}"
                Message="{x:Bind ViewModel.ClaudeMessage, Mode=OneWay}"
                Severity="Warning"
                Title="Claude Code isn’t set up.">
                <InfoBar.IconSource>
                    <FontIconSource FontFamily="{StaticResource StudioIconsFontFamily}" Glyph="{x:Bind icons:StudioIcons.WarningFilled}" />
                </InfoBar.IconSource>
                <InfoBar.ActionButton>
                    <Button Click="OnSetUpClaude" Content="Set up in Settings" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                Severity="Error"
                Title="Couldn’t read the deliverables.">
                <InfoBar.IconSource>
                    <FontIconSource FontFamily="{StaticResource StudioIconsFontFamily}" Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                </InfoBar.IconSource>
            </InfoBar>

            <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border VerticalAlignment="Top" Style="{StaticResource FlushCardStyle}">
                    <ListView
                        x:Name="RoleList"
                        Padding="0,4"
                        AutomationProperties.Name="Roles"
                        ItemsSource="{x:Bind ViewModel.Roles, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedRole, Mode=OneWay}"
                        SelectionChanged="OnRoleSelected"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoleRow">
                                <StackPanel
                                    Padding="0,8"
                                    AutomationProperties.Name="{x:Bind AnnouncedName}"
                                    Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconStyle}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <ProgressRing
                                            Grid.Column="2"
                                            Width="12"
                                            Height="12"
                                            MinWidth="12"
                                            MinHeight="12"
                                            IsActive="{x:Bind IsRunning}"
                                            Visibility="{x:Bind IsRunning}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar VerticalAlignment="Center" Value="{x:Bind Percent}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="{x:Bind Progress}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource TileStyle}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Glyph="{x:Bind ViewModel.SelectedRole.Glyph, Mode=OneWay}"
                                        Style="{StaticResource IconStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SelectedRole.Name, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.RoleKind, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedRole.Workstream.Role.Purpose, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,12,0,4"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="Deliverables it drafts" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Deliverables, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeliverableRow">
                                        <Grid
                                            MinHeight="40"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind icons:StudioIcons.Deliverables}"
                                                Style="{StaticResource IconStyle}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <controls:StatusPill Grid.Column="2" State="{x:Bind Pill}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FlushCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource CardHeaderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind icons:StudioIcons.Agent}"
                                    Style="{StaticResource IconStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Agent tasks" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="Agents write drafts in docs/ only" />
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskRow">
                                        <Grid
                                            Padding="16,12"
                                            AutomationProperties.Name="{x:Bind AnnouncedName}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ArgumentLine}" />
                                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind WritesLine}" />
                                                <StackPanel
                                                    Margin="0,4,0,0"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Visibility="{x:Bind IsBlocked}">
                                                    <controls:StatusPill State="Blocked" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind BlockedReason}"
                                                        TextWrapping="Wrap" />
                                                    <HyperlinkButton
                                                        Padding="4,0"
                                                        Click="OnOpenBlockingRun"
                                                        Content="Open run" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Click="OnRun"
                                                IsEnabled="{x:Bind CanRun}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind icons:StudioIcons.Run}" Style="{StaticResource IconStyle}" />
                                                    <TextBlock Text="Run…" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FlushCardStyle}">
                        <StackPanel>
                            <Grid Style="{StaticResource CardHeaderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind icons:StudioIcons.History}"
                                    Style="{StaticResource IconStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Run history" />
                            </Grid>
                            <TextBlock
                                Padding="16,8,16,16"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="No runs yet. A run shows its live transcript, and what it writes lands as Draft for a person to review."
                                Visibility="{x:Bind ViewModel.HasNoHistory, Mode=OneWay}" />
                            <StackPanel Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                                <Grid Style="{StaticResource TableHeaderStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Task and scope" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Started, ended" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Outcome" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Cost" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Turns" />
                                </Grid>
                                <ListView
                                    AutomationProperties.Name="Run history"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnHistoryClicked"
                                    ItemContainerStyle="{StaticResource TableRowStyle}"
                                    ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryRow">
                                            <Grid AutomationProperties.Name="{x:Bind AnnouncedName}" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="132" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock Style="{StaticResource MonoTextStyle}" Text="{x:Bind ArgumentText}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind When}" />
                                                <controls:StatusPill
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Left"
                                                    State="{x:Bind Pill}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Cost}" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Turns}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
