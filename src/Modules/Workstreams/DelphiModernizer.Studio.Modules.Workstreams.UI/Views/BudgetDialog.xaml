<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="DelphiModernizer.Studio.Modules.Workstreams.UI.Views.BudgetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:local="using:DelphiModernizer.Studio.Modules.Workstreams.UI.Views"
    CloseButtonText="Close"
    DefaultButton="None"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    PrimaryButtonText="Run again"
    SecondaryButtonText="Open the draft"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="This run reached its budget">

    <ContentDialog.Resources>
        <local:DollarFormatter x:Key="Dollars" />
        <!--  The primary button's text with the play icon, as drawn; set on the button once its template exists.  -->
        <DataTemplate x:Key="PlayContent" x:DataType="x:String">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind icons:StudioIcons.Run}" Style="{StaticResource IconStyle}" />
                <TextBlock Text="{x:Bind}" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <StackPanel Spacing="16">
        <TextBlock
            x:Name="Lead"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap" />
        <Grid ColumnSpacing="16" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Spent" />
            <TextBlock
                x:Name="Spent"
                Grid.Column="1"
                Style="{StaticResource BodyTextBlockStyle}" />
            <TextBlock
                Grid.Row="1"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="Outcome" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource MonoTextStyle}"
                Text="error_max_budget_usd" />
        </Grid>
        <!--  Canvas .fld at max-width 240: the field takes it all, not the width of its wrapped help.  -->
        <StackPanel
            Width="240"
            HorizontalAlignment="Left"
            Spacing="8">
            <TextBlock Text="Budget for a new run" />
            <!--  Canvas .nbx, as Settings draws it: the grey "$" inside the box, before the value.  -->
            <Grid>
                <NumberBox
                    x:Name="BudgetBox"
                    Padding="24,5,6,6"
                    AutomationProperties.HelpText="A new run starts the task again with the same scope."
                    AutomationProperties.Name="Budget for a new run"
                    LargeChange="1"
                    Minimum="0.1"
                    NumberFormatter="{StaticResource Dollars}"
                    SmallChange="0.5"
                    SpinButtonPlacementMode="Inline" />
                <TextBlock
                    Margin="11,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="$" />
            </Grid>
            <TextBlock
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="A new run starts the task again with the same scope." />
        </StackPanel>
    </StackPanel>
</ContentDialog>
