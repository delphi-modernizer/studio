<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="DelphiModernizer.Studio.Modules.Workstreams.UI.Views.RunRecipeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:local="using:DelphiModernizer.Studio.Modules.Workstreams.UI.Views"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Run"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <local:DollarFormatter x:Key="Dollars" />
        <!--  The primary button's text with the play icon, as drawn; set on the button once its template exists.  -->
        <DataTemplate x:Key="PlayContent" x:DataType="x:String">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="{x:Bind icons:StudioIcons.Run}" Style="{StaticResource IconStyle}" />
                <TextBlock Text="{x:Bind}" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <StackPanel Spacing="2">
            <TextBlock x:Name="RoleText" Style="{StaticResource SecondaryCaptionTextStyle}" />
            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
    </ContentDialog.Title>

    <StackPanel Spacing="16">
        <TextBlock
            x:Name="Lead"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap" />
        <StackPanel x:Name="ArgumentField" Spacing="8">
            <TextBox x:Name="ArgumentBox" />
            <ComboBox
                x:Name="GateBox"
                MinWidth="240"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="ArgumentError"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="ArgumentHelp"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="One line, for example legacy/Sales or Pricing.pas." />
        </StackPanel>
        <!--  Canvas .fld at max-width 240: the field takes it all, not the width of its wrapped help.  -->
        <StackPanel
            Width="240"
            HorizontalAlignment="Left"
            Spacing="8">
            <TextBlock Text="Budget for this run" />
            <!--  Canvas .nbx, as Settings draws it: the grey "$" inside the box, before the value.  -->
            <Grid>
                <NumberBox
                    x:Name="BudgetBox"
                    Padding="24,5,6,6"
                    controls:SpinButtons.IsCanvas="True"
                    AutomationProperties.HelpText="The run stops when it reaches this. The default comes from Settings."
                    AutomationProperties.Name="Budget for this run"
                    LargeChange="1"
                    Minimum="0.1"
                    NumberFormatter="{StaticResource Dollars}"
                    SmallChange="0.5"
                    SpinButtonPlacementMode="Inline" />
                <TextBlock
                    Margin="11,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsHitTestVisible="False"
                    Text="$" />
            </Grid>
            <TextBlock
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="The run stops when it reaches this. The default comes from Settings." />
        </StackPanel>
        <InfoBar
            IsClosable="False"
            IsOpen="True"
            Severity="Informational">
            <InfoBar.Message>
                The guard keeps the agent in docs/. It can’t change the Delphi code, approve a sign-off, choose the
                platform, or write new code before the final plan is approved.
            </InfoBar.Message>
            <InfoBar.IconSource>
                <FontIconSource
                    FontFamily="{StaticResource StudioIconsFontFamily}"
                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                    Glyph="{x:Bind icons:StudioIcons.GuardRefused}" />
            </InfoBar.IconSource>
        </InfoBar>
        <InfoBar
            x:Name="StartProblem"
            IsClosable="False"
            Severity="Error"
            Title="The run didn’t start.">
            <InfoBar.IconSource>
                <FontIconSource
                    FontFamily="{StaticResource StudioIconsFontFamily}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
            </InfoBar.IconSource>
        </InfoBar>
    </StackPanel>
</ContentDialog>
