<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Overview.UI.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <controls:PageHeader Purpose="How a workspace stands, from the Delphi code to an approved plan." Title="Overview" />
            <controls:NoWorkspaceState
                Glyph="{x:Bind icons:StudioIcons.Overview}"
                Message="Open a workspace, or start one from a Delphi source tree, to see how its modernization stands. Every page stays reachable and fills in once a workspace is open."
                Visibility="{x:Bind ViewModel.HasNoWorkspace, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
