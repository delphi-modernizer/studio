<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Overview.UI.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:local="using:DelphiModernizer.Studio.Modules.Overview.UI.Views"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.Overview.UI.ViewModels"
    Loaded="OnLoaded">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="FlowNextStroke" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="FlowNextText" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="FlowGroupStroke" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="FlowGroupFill" ResourceKey="SubtleFillColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="FlowNextStroke" ResourceKey="AccentFillColorDefaultBrush" />
                    <StaticResource x:Key="FlowNextText" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="FlowGroupStroke" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="FlowGroupFill" ResourceKey="SubtleFillColorSecondaryBrush" />
                </ResourceDictionary>
                <!--
                    In high contrast the accent fill is the window colour, so the border uses Highlight; Next is drawn
                    in the hyperlink colour, and the groups lose their fill, so they take an outline.
                -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="FlowNextStroke" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FlowNextText" Color="{ThemeResource SystemColorHotlightColor}" />
                    <StaticResource x:Key="FlowGroupStroke" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="FlowGroupFill" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style
                x:Key="FlowNodeStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <!--  The next sign-off carries the accent border (handoff colour roles).  -->
            <Style
                x:Key="NextFlowNodeStyle"
                BasedOn="{StaticResource FlowNodeStyle}"
                TargetType="Button">
                <Setter Property="BorderBrush" Value="{ThemeResource FlowNextStroke}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style x:Key="FlowLineStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="FlowHeadStyle" TargetType="Polygon">
                <Setter Property="Fill" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            </Style>
            <Style
                x:Key="FlowLabelStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <Style x:Key="FlowGroupStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource FlowGroupFill}" />
                <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                <Setter Property="BorderBrush" Value="{ThemeResource FlowGroupStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="PhaseNumberStyle" TargetType="Border">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style
                x:Key="PhaseTextStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="NodeTileStyle" TargetType="Border">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <DataTemplate x:Key="TeamNodeTemplate" x:DataType="vm:TeamNode">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource NodeTileStyle}">
                        <FontIcon
                            FontSize="18"
                            Glyph="{x:Bind Glyph}"
                            Style="{StaticResource IconStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="{x:Bind Progress}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Visibility="{x:Bind IsIdle}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind IsRunning}">
                            <ProgressRing
                                Width="12"
                                Height="12"
                                MinWidth="12"
                                MinHeight="12"
                                IsActive="{x:Bind IsRunning}" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Agent running" />
                        </StackPanel>
                    </StackPanel>
                    <FontIcon
                        Grid.Column="2"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                        Style="{StaticResource IconStyle}" />
                </Grid>
            </DataTemplate>

            <!--  Under 1100 the teams sit two to a row and drop their tile.  -->
            <DataTemplate x:Key="TeamNodeCompactTemplate" x:DataType="vm:TeamNode">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionTextStyle}"
                            Text="{x:Bind Progress}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Visibility="{x:Bind IsIdle}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind IsRunning}">
                            <ProgressRing
                                Width="12"
                                Height="12"
                                MinWidth="12"
                                MinHeight="12"
                                IsActive="{x:Bind IsRunning}" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Agent running" />
                        </StackPanel>
                    </StackPanel>
                    <FontIcon
                        Grid.Column="1"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                        Style="{StaticResource IconStyle}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GateNodeTemplate" x:DataType="vm:GateNode">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <FontIcon
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                            Style="{StaticResource IconStyle}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:StatusPill State="{x:Bind Pill}" />
                        <!--  Trimmed like the pill's word, so the two share a baseline.  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource FlowNextText}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Next"
                            TextLineBounds="TrimToCapHeight"
                            Visibility="{x:Bind IsNext}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>

            <!--  Under 1100 each sign-off is one row: name, Next sign-off, pill, chevron.  -->
            <DataTemplate x:Key="GateNodeOneLineTemplate" x:DataType="vm:GateNode">
                <Grid VerticalAlignment="Center" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource FlowNextText}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Next sign-off"
                            Visibility="{x:Bind IsNext}" />
                    </StackPanel>
                    <controls:StatusPill Grid.Column="1" State="{x:Bind Pill}" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                        Style="{StaticResource IconStyle}" />
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Spacing" Value="16" />
                        <Setter Target="Below.ColumnSpacing" Value="0" />
                        <Setter Target="Below.RowSpacing" Value="16" />
                        <Setter Target="RunsColumn.Width" Value="0" />
                        <Setter Target="RunsCard.(Grid.Row)" Value="1" />
                        <Setter Target="RunsCard.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <!--  The page fills the width up to its MaxWidth and stays left-aligned beyond it.  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    x:Name="PageContent"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PageContentStyle}">
                    <controls:PageHeader Purpose="{x:Bind ViewModel.Purpose, Mode=OneWay}" Title="Overview">
                        <controls:PageHeader.Actions>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.HasWorkspace, Mode=OneWay}">
                                <Button
                                    Command="{x:Bind ViewModel.LoadCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            Glyph="{x:Bind icons:StudioIcons.Refresh}"
                                            Style="{StaticResource IconStyle}" />
                                        <TextBlock Text="Check traceability" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="OnReviewSignOffs"
                                    IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            Glyph="{x:Bind icons:StudioIcons.SignOffs}"
                                            Style="{StaticResource IconStyle}" />
                                        <TextBlock Text="Review sign-offs" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:PageHeader.Actions>
                    </controls:PageHeader>

                    <controls:NoWorkspaceState
                        Glyph="{x:Bind icons:StudioIcons.Overview}"
                        Visibility="{x:Bind ViewModel.HasNoWorkspace, Mode=OneWay}">
                        <controls:NoWorkspaceState.Message>
                            Open a workspace, or start one from a Delphi source tree, to see how its modernization
                            stands. Every page stays reachable and fills in once a workspace is open.
                        </controls:NoWorkspaceState.Message>
                    </controls:NoWorkspaceState>

                    <!--  Centred in the page's first 520, as drawn.  -->
                    <Grid MinHeight="520" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Spacing="8">
                            <ProgressRing
                                Width="32"
                                Height="32"
                                Margin="0,0,0,12"
                                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.LoadingTitle, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                Text="Checking sign-offs, deliverables and traceability" />
                        </StackPanel>
                    </Grid>

                    <InfoBar
                        AutomationProperties.LiveSetting="Assertive"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasLoadProblem, Mode=OneWay}"
                        Message="{x:Bind ViewModel.LoadProblem, Mode=OneWay}"
                        Severity="Error"
                        Title="Couldn’t read this workspace.">
                        <InfoBar.IconSource>
                            <FontIconSource
                                FontFamily="{StaticResource StudioIconsFontFamily}"
                                Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                        </InfoBar.IconSource>
                        <InfoBar.ActionButton>
                            <Button Command="{x:Bind ViewModel.LoadCommand}" Content="Try again" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
                        <InfoBar
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.NextStep.Message, Mode=OneWay}"
                            Severity="{x:Bind local:OverviewPage.SeverityOf(ViewModel.NextStep), Mode=OneWay}"
                            Title="{x:Bind ViewModel.NextStep.Title, Mode=OneWay}">
                            <InfoBar.IconSource>
                                <FontIconSource
                                    FontFamily="{StaticResource StudioIconsFontFamily}"
                                    Glyph="{x:Bind ViewModel.NextStep.Glyph, Mode=OneWay}" />
                            </InfoBar.IconSource>
                            <InfoBar.ActionButton>
                                <Button
                                    Click="OnNextStepAction"
                                    Content="{x:Bind ViewModel.NextStep.ActionText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.NextStep.HasAction, Mode=OneWay}" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <Border Style="{StaticResource FlushCardStyle}">
                            <StackPanel>
                                <StackPanel
                                    Padding="20,12,20,10"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Spacing="2">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="How the work flows" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                                </StackPanel>

                                <!--  OverviewPage.Flow.cs places the parts with the design's measurements.  -->
                                <local:AutomationGroup>
                                    <AutomationProperties.Name>
                                        From the Delphi code, through six teams and the Principal Architect, to five
                                        sign-offs and the build
                                    </AutomationProperties.Name>
                                    <Canvas
                                        x:Name="Flow"
                                        SizeChanged="OnFlowSizeChanged"
                                        XYFocusKeyboardNavigation="Enabled">
                                        <Canvas x:Name="Decorations" />
                                        <Border x:Name="TeamsGroup" Style="{StaticResource FlowGroupStyle}" />
                                        <Border x:Name="GatesGroup" Style="{StaticResource FlowGroupStyle}" />
                                        <StackPanel
                                            x:Name="Phase1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Border Style="{StaticResource PhaseNumberStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="1" />
                                            </Border>
                                            <TextBlock Style="{StaticResource PhaseTextStyle}" Text="Delphi code" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="Phase2"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Border Style="{StaticResource PhaseNumberStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="2" />
                                            </Border>
                                            <TextBlock
                                                Style="{StaticResource PhaseTextStyle}"
                                                Text="Six teams draft, side by side" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="Phase3"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Border Style="{StaticResource PhaseNumberStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="3" />
                                            </Border>
                                            <TextBlock x:Name="Phase3Text" Style="{StaticResource PhaseTextStyle}" />
                                        </StackPanel>
                                        <StackPanel
                                            x:Name="Phase4"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Border Style="{StaticResource PhaseNumberStyle}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="4" />
                                            </Border>
                                            <TextBlock
                                                Style="{StaticResource PhaseTextStyle}"
                                                Text="People sign off, in order" />
                                        </StackPanel>

                                        <Button
                                            x:Name="LegacyNodeButton"
                                            x:DefaultBindMode="OneWay"
                                            Padding="14,12"
                                            AutomationProperties.Name="{x:Bind ViewModel.Legacy.AnnouncedName}"
                                            Click="OnLegacyClicked"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="Opens Inventory">
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource NodeTileStyle}">
                                                        <FontIcon
                                                            x:DefaultBindMode="OneTime"
                                                            FontSize="18"
                                                            Glyph="{x:Bind icons:StudioIcons.DelphiCode}"
                                                            Style="{StaticResource IconStyle}" />
                                                    </Border>
                                                    <FontIcon
                                                        x:DefaultBindMode="OneTime"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                                                        Style="{StaticResource IconStyle}" />
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="Delphi code" />
                                                    <TextBlock
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind ViewModel.Legacy.Subtitle}"
                                                        Visibility="{x:Bind local:OverviewPage.ShownIf(ViewModel.Legacy.Subtitle)}" />
                                                </StackPanel>
                                                <!--  One fact a line, as drawn, so all three fit the node.  -->
                                                <StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind ViewModel.Legacy.First}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind ViewModel.Legacy.Second}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind ViewModel.Legacy.Third}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            x:Name="Team0"
                                            x:DefaultBindMode="OneWay"
                                            Padding="10,9,10,5"
                                            AutomationProperties.Name="{x:Bind ViewModel.Teams[0].AnnouncedName}"
                                            Click="OnTeamClicked"
                                            Content="{x:Bind ViewModel.Teams[0]}"
                                            ContentTemplate="{StaticResource TeamNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Teams[0].ToolTip}" />
                                        <Button
                                            x:Name="Team1"

                                            x:DefaultBindMode="OneWay"
                                            Padding="10,9,10,5"
                                            AutomationProperties.Name="{x:Bind ViewModel.Teams[1].AnnouncedName}"
                                            Click="OnTeamClicked"
                                            Content="{x:Bind ViewModel.Teams[1]}"
                                            ContentTemplate="{StaticResource TeamNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Teams[1].ToolTip}" />
                                        <Button
                                            x:Name="Team2"

                                            x:DefaultBindMode="OneWay"
                                            Padding="10,9,10,5"
                                            AutomationProperties.Name="{x:Bind ViewModel.Teams[2].AnnouncedName}"
                                            Click="OnTeamClicked"
                                            Content="{x:Bind ViewModel.Teams[2]}"
                                            ContentTemplate="{StaticResource TeamNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Teams[2].ToolTip}" />
                                        <Button
                                            x:Name="Team3"

                                            x:DefaultBindMode="OneWay"
                                            Padding="10,9,10,5"
                                            AutomationProperties.Name="{x:Bind ViewModel.Teams[3].AnnouncedName}"
                                            Click="OnTeamClicked"
                                            Content="{x:Bind ViewModel.Teams[3]}"
                                            ContentTemplate="{StaticResource TeamNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Teams[3].ToolTip}" />
                                        <Button
                                            x:Name="Team4"

                                            x:DefaultBindMode="OneWay"
                                            Padding="10,9,10,5"
                                            AutomationProperties.Name="{x:Bind ViewModel.Teams[4].AnnouncedName}"
                                            Click="OnTeamClicked"
                                            Content="{x:Bind ViewModel.Teams[4]}"
                                            ContentTemplate="{StaticResource TeamNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Teams[4].ToolTip}" />
                                        <Button
                                            x:Name="Team5"

                                            x:DefaultBindMode="OneWay"
                                            Padding="10,9,10,5"
                                            AutomationProperties.Name="{x:Bind ViewModel.Teams[5].AnnouncedName}"
                                            Click="OnTeamClicked"
                                            Content="{x:Bind ViewModel.Teams[5]}"
                                            ContentTemplate="{StaticResource TeamNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Teams[5].ToolTip}" />

                                        <Button
                                            x:Name="ArchitectNodeButton"
                                            x:DefaultBindMode="OneWay"
                                            Padding="14,12"
                                            AutomationProperties.Name="{x:Bind ViewModel.Architect.AnnouncedName}"
                                            Click="OnArchitectClicked"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.Architect.ToolTip}">
                                            <StackPanel Spacing="8">
                                                <Grid Margin="0,0,0,4">
                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource NodeTileStyle}">
                                                        <FontIcon
                                                            x:DefaultBindMode="OneTime"
                                                            FontSize="18"
                                                            Glyph="{x:Bind icons:StudioIcons.PrincipalArchitect}"
                                                            Style="{StaticResource IconStyle}" />
                                                    </Border>
                                                    <FontIcon
                                                        x:DefaultBindMode="OneTime"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                                                        Style="{StaticResource IconStyle}" />
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="Principal Architect"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind ViewModel.Architect.Progress, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="Combines the drafts and flags contradictions" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            x:Name="Gate0"
                                            x:DefaultBindMode="OneWay"
                                            AutomationProperties.Name="{x:Bind ViewModel.Gates[0].AnnouncedName}"
                                            Click="OnGateClicked"
                                            Content="{x:Bind ViewModel.Gates[0]}"
                                            ContentTemplate="{StaticResource GateNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="Opens Sign-offs" />
                                        <Button
                                            x:Name="Gate1"

                                            x:DefaultBindMode="OneWay"
                                            AutomationProperties.Name="{x:Bind ViewModel.Gates[1].AnnouncedName}"
                                            Click="OnGateClicked"
                                            Content="{x:Bind ViewModel.Gates[1]}"
                                            ContentTemplate="{StaticResource GateNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="Opens Sign-offs" />
                                        <Button
                                            x:Name="Gate2"

                                            x:DefaultBindMode="OneWay"
                                            AutomationProperties.Name="{x:Bind ViewModel.Gates[2].AnnouncedName}"
                                            Click="OnGateClicked"
                                            Content="{x:Bind ViewModel.Gates[2]}"
                                            ContentTemplate="{StaticResource GateNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="Opens Sign-offs" />
                                        <Button
                                            x:Name="Gate3"

                                            x:DefaultBindMode="OneWay"
                                            AutomationProperties.Name="{x:Bind ViewModel.Gates[3].AnnouncedName}"
                                            Click="OnGateClicked"
                                            Content="{x:Bind ViewModel.Gates[3]}"
                                            ContentTemplate="{StaticResource GateNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="Opens Sign-offs" />
                                        <Button
                                            x:Name="Gate4"

                                            x:DefaultBindMode="OneWay"
                                            AutomationProperties.Name="{x:Bind ViewModel.Gates[4].AnnouncedName}"
                                            Click="OnGateClicked"
                                            Content="{x:Bind ViewModel.Gates[4]}"
                                            ContentTemplate="{StaticResource GateNodeTemplate}"
                                            Style="{StaticResource FlowNodeStyle}"
                                            ToolTipService.ToolTip="Opens Sign-offs" />

                                        <!--  The build is not a stop: it opens once the final plan is approved.  -->
                                        <local:AutomationGroup
                                            x:Name="BuildBox"
                                            x:DefaultBindMode="OneWay"
                                            AutomationProperties.Name="{x:Bind ViewModel.Build.AnnouncedName}">
                                            <Rectangle
                                                RadiusX="8"
                                                RadiusY="8"
                                                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                StrokeDashArray="4,3"
                                                Visibility="{x:Bind ViewModel.Build.IsLocked}" />
                                            <Border
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{x:Bind ViewModel.Build.IsUnlocked}" />
                                            <!--  Flow.cs puts the pill under the name when wide, as drawn.  -->
                                            <Grid
                                                x:Name="BuildLayout"
                                                Padding="12,8"
                                                VerticalAlignment="Center"
                                                ColumnSpacing="10"
                                                RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <FontIcon
                                                    x:DefaultBindMode="OneTime"
                                                    Glyph="{x:Bind icons:StudioIcons.Build}"
                                                    Style="{StaticResource IconStyle}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="Build the new system"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        x:Name="BuildSubtitle"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind ViewModel.Build.Subtitle}" />
                                                </StackPanel>
                                                <controls:StatusPill
                                                    x:Name="BuildPill"
                                                    Grid.Column="2"
                                                    State="{x:Bind ViewModel.Build.Pill}" />
                                            </Grid>
                                        </local:AutomationGroup>

                                        <local:FlowLegend x:Name="LegendInside" />
                                    </Canvas>
                                </local:AutomationGroup>

                                <Border
                                    x:Name="LegendBelow"
                                    Padding="20,10,20,12"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="Collapsed">
                                    <local:FlowLegend />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="Below" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="RunsColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border VerticalAlignment="Top" Style="{StaticResource FlushCardStyle}">
                                <StackPanel>
                                    <StackPanel
                                        Padding="16,12,16,4"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Open questions" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind ViewModel.QuestionCount, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{x:Bind ViewModel.HasQuestions, Mode=OneWay}">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Questions, Mode=OneWay}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:QuestionRow">
                                                    <Grid
                                                        MinHeight="52"
                                                        Padding="16,8"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock
                                                                Style="{StaticResource BodyTextBlockStyle}"
                                                                Text="{x:Bind Text}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Style="{StaticResource SecondaryCaptionTextStyle}">
                                                                <Run Text="Asked in the project charter · " />
                                                                <Run
                                                                    FontFamily="Cascadia Mono,Consolas"
                                                                    Text="{x:Bind Id}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <controls:StatusPill Grid.Column="1" State="Open" />
                                                        <Button
                                                            Grid.Column="2"
                                                            Click="OnQuestionClicked"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="Open in your editor">
                                                            <AutomationProperties.Name>
                                                                Open this question in your editor
                                                            </AutomationProperties.Name>
                                                            <FontIcon
                                                                Glyph="{x:Bind icons:StudioIcons.OpenInEditor}"
                                                                Style="{StaticResource IconStyle}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <TextBlock
                                            Padding="16,8,16,12"
                                            Style="{StaticResource SecondaryCaptionTextStyle}">
                                            Every question needs an answer before the final plan can be signed off.
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel
                                        Padding="16,24"
                                        HorizontalAlignment="Center"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.HasNoQuestions, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="24"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind icons:StudioIcons.Ready}"
                                            Style="{StaticResource IconStyle}" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="No open questions." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="RunsCard"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Style="{StaticResource FlushCardStyle}">
                                <StackPanel>
                                    <Grid Padding="16,12,16,4">
                                        <TextBlock
                                            AutomationProperties.HeadingLevel="Level2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Recent agent runs" />
                                        <HyperlinkButton
                                            Margin="0,-6,-11,-6"
                                            HorizontalAlignment="Right"
                                            Click="OnAllRuns"
                                            Content="All runs"
                                            Visibility="{x:Bind ViewModel.HasRuns, Mode=OneWay}" />
                                    </Grid>
                                    <ItemsRepeater
                                        ItemsSource="{x:Bind ViewModel.Runs, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasRuns, Mode=OneWay}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RunRow">
                                                <Grid
                                                    MinHeight="52"
                                                    Padding="16,8"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        FontSize="20"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="{x:Bind icons:StudioIcons.Agent}"
                                                        Style="{StaticResource IconStyle}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Style="{StaticResource BodyTextBlockStyle}"
                                                            Text="{x:Bind Title}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                                            Text="{x:Bind Subtitle}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <controls:StatusPill Grid.Column="2" State="{x:Bind Pill}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <controls:EmptyState
                                        Glyph="{x:Bind icons:StudioIcons.Agent}"
                                        Message="{x:Bind ViewModel.RunsEmptyText, Mode=OneWay}"
                                        Title="{x:Bind ViewModel.RunsEmptyTitle, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasNoRuns, Mode=OneWay}">
                                        <HyperlinkButton
                                            Click="OnRunsEmptyLink"
                                            Content="{x:Bind ViewModel.RunsEmptyLink, Mode=OneWay}" />
                                    </controls:EmptyState>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
