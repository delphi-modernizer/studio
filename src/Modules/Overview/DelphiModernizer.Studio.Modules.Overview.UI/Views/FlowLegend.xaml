<UserControl
    x:Class="DelphiModernizer.Studio.Modules.Overview.UI.Views.FlowLegend"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    AutomationProperties.Name="Legend"
    IsTabStop="False">

    <controls:WrapPanel HorizontalSpacing="20" VerticalSpacing="4">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Glyph="{x:Bind icons:StudioIcons.Approved}"
                Style="{StaticResource IconStyle}" />
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Approved by a person" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon
                FontSize="14"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="{x:Bind icons:StudioIcons.Ready}"
                Style="{StaticResource IconStyle}" />
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Ready for sign-off" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{x:Bind icons:StudioIcons.Blocked}"
                Style="{StaticResource IconStyle}" />
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Blocked" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <!--  Turning, like the ring it explains; an inactive ProgressRing draws nothing.  -->
            <ProgressRing
                Width="12"
                Height="12"
                MinWidth="12"
                MinHeight="12"
                AutomationProperties.AccessibilityView="Raw"
                IsActive="True" />
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Agent running" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{x:Bind icons:StudioIcons.Locked}"
                Style="{StaticResource IconStyle}" />
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Locked" />
        </StackPanel>
    </controls:WrapPanel>
</UserControl>
