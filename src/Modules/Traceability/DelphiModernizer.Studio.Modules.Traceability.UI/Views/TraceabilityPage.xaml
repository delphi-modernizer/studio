<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Traceability.UI.Views.TraceabilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.Traceability.UI.ViewModels"
    Loaded="OnLoaded">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  In high contrast a row under the pointer takes a button's colours, so secondary text stays.  -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush
                        x:Key="ListViewItemBackgroundPointerOver"
                        Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush
                        x:Key="ListViewItemBackgroundPressed"
                        Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush
                        x:Key="ListViewItemForegroundPointerOver"
                        Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush
                        x:Key="ListViewItemForegroundPressed"
                        Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  A summary card (handoff: padding 10 16 12); a status glyph's brush follows the page's theme.  -->
            <DataTemplate x:Key="StatTemplate" x:DataType="vm:StatCard">
                <Border Padding="16,10,16,12" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind Glyph}"
                                Style="{StaticResource IconStyle}" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Label}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2,0,0"
                            Orientation="Horizontal"
                            Spacing="6">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="{x:Bind StatusGlyph}"
                                Style="{StaticResource IconStyle}"
                                Visibility="{x:Bind IsSuccess}" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="{x:Bind StatusGlyph}"
                                Style="{StaticResource IconStyle}"
                                Visibility="{x:Bind IsCaution}" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="{x:Bind StatusGlyph}"
                                Style="{StaticResource IconStyle}"
                                Visibility="{x:Bind IsCritical}" />
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind Number}" />
                            <TextBlock
                                Margin="0,0,0,5"
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind Unit}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Detail}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!--  Under 1100 the stat numbers drop to 24 / 32.  -->
            <DataTemplate x:Key="StatNarrowTemplate" x:DataType="vm:StatCard">
                <Border Padding="12,10,12,12" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind Glyph}"
                                Style="{StaticResource IconStyle}" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Label}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2,0,0"
                            Orientation="Horizontal"
                            Spacing="6">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="{x:Bind StatusGlyph}"
                                Style="{StaticResource IconStyle}"
                                Visibility="{x:Bind IsSuccess}" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="{x:Bind StatusGlyph}"
                                Style="{StaticResource IconStyle}"
                                Visibility="{x:Bind IsCaution}" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="{x:Bind StatusGlyph}"
                                Style="{StaticResource IconStyle}"
                                Visibility="{x:Bind IsCritical}" />
                            <TextBlock
                                FontSize="24"
                                LineHeight="32"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind Number}" />
                            <TextBlock
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind Unit}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind Detail}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!--  Under 1100 the stat numbers drop to 24 / 32; the four cards stay in one row.  -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Spacing" Value="16" />
                        <Setter Target="Stat0.ContentTemplate" Value="{StaticResource StatNarrowTemplate}" />
                        <Setter Target="Stat1.ContentTemplate" Value="{StaticResource StatNarrowTemplate}" />
                        <Setter Target="Stat2.ContentTemplate" Value="{StaticResource StatNarrowTemplate}" />
                        <Setter Target="Stat3.ContentTemplate" Value="{StaticResource StatNarrowTemplate}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer x:Name="PageScroller">
            <StackPanel x:Name="PageContent" Style="{StaticResource PageContentStyle}">
                <controls:PageHeader Title="Traceability">
                    <controls:PageHeader.Purpose>
                        Checks that every claim in the documents is backed by evidence and that every reference points
                        to something real.
                    </controls:PageHeader.Purpose>
                    <controls:PageHeader.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.HasWorkspace, Mode=OneWay}">
                            <ToggleSwitch
                                AutomationProperties.Name="Strict: warnings count as errors"
                                IsOn="{x:Bind ViewModel.Strict, Mode=TwoWay}"
                                OffContent="Count warnings as errors"
                                OnContent="Count warnings as errors" />
                            <Button
                                Command="{x:Bind ViewModel.CheckCommand}"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        Glyph="{x:Bind icons:StudioIcons.Refresh}"
                                        Style="{StaticResource IconStyle}" />
                                    <TextBlock Text="Check again" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:PageHeader.Actions>
                </controls:PageHeader>

                <controls:NoWorkspaceState
                    Glyph="{x:Bind icons:StudioIcons.Traceability}"
                    Visibility="{x:Bind ViewModel.HasNoWorkspace, Mode=OneWay}">
                    <controls:NoWorkspaceState.Message>
                        Traceability checks a workspace’s documents: every claim backed by evidence, every reference
                        pointing to something real. Open or start a workspace to check it.
                    </controls:NoWorkspaceState.Message>
                </controls:NoWorkspaceState>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasLoadProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.LoadProblem, Mode=OneWay}"
                    Severity="Error"
                    Title="Couldn’t check the documents."
                    Visibility="{x:Bind ViewModel.HasLoadProblem, Mode=OneWay}">
                    <InfoBar.IconSource>
                        <FontIconSource
                            FontFamily="{StaticResource StudioIconsFontFamily}"
                            Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                    </InfoBar.IconSource>
                </InfoBar>

                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.Strict, Mode=OneWay}"
                        Message="This is how the final plan’s sign-off checks the documents."
                        Severity="Informational"
                        Title="Warnings count as errors."
                        Visibility="{x:Bind ViewModel.Strict, Mode=OneWay}">
                        <InfoBar.IconSource>
                            <FontIconSource
                                FontFamily="{StaticResource StudioIconsFontFamily}"
                                Glyph="{x:Bind icons:StudioIcons.InfoFilled}" />
                        </InfoBar.IconSource>
                    </InfoBar>

                    <!--  Four cards in one row at every width, each as tall as the tallest.  -->
                    <Grid AutomationProperties.Name="Summary" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            x:Name="Stat0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.Stats[0], Mode=OneWay}"
                            ContentTemplate="{StaticResource StatTemplate}" />
                        <ContentPresenter
                            x:Name="Stat1"
                            Grid.Column="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.Stats[1], Mode=OneWay}"
                            ContentTemplate="{StaticResource StatTemplate}" />
                        <ContentPresenter
                            x:Name="Stat2"
                            Grid.Column="2"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.Stats[2], Mode=OneWay}"
                            ContentTemplate="{StaticResource StatTemplate}" />
                        <ContentPresenter
                            x:Name="Stat3"
                            Grid.Column="3"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.Stats[3], Mode=OneWay}"
                            ContentTemplate="{StaticResource StatTemplate}" />
                    </Grid>

                    <SelectorBar
                        x:Name="ViewBar"
                        AutomationProperties.Name="Traceability views"
                        SelectionChanged="OnViewChanged" />

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsClean, Mode=OneWay}">
                        <StackPanel
                            Padding="16,32"
                            HorizontalAlignment="Center"
                            Spacing="8">
                            <FontIcon
                                FontSize="48"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="{x:Bind icons:StudioIcons.CheckPassed}"
                                Style="{StaticResource IconStyle}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="No errors or warnings" />
                            <TextBlock
                                MaxWidth="480"
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap">
                                Sign-offs that need clean documents can pass now. The final plan also counts
                                warnings, such as open questions and requirements without a test.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource FlushCardStyle}"
                        Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}">
                        <StackPanel>
                            <Grid Padding="16,6,8,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="Opening an issue opens its file at the line in your editor." />
                                <SelectorBar
                                    x:Name="SeverityBar"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Severity"
                                    SelectionChanged="OnSeverityChanged" />
                            </Grid>
                            <Grid Style="{StaticResource TableHeaderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Severity" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource TableHeaderTextStyle}"
                                    Text="Problem" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource TableHeaderTextStyle}"
                                    Text="Where" />
                            </Grid>
                            <ListView
                                x:Name="ProblemsList"
                                AutomationProperties.Name="Issues"
                                IsItemClickEnabled="True"
                                ItemClick="OnRowClicked"
                                ItemContainerStyle="{StaticResource TableRowStyle}"
                                ItemsSource="{x:Bind ViewModel.Problems, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProblemRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="240" />
                                            </Grid.ColumnDefinitions>
                                            <controls:StatusPill
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                State="{x:Bind Pill}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                                    Text="{x:Bind Rule}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <HyperlinkButton
                                                    Padding="0"
                                                    AutomationProperties.Name="{x:Bind FileLink}"
                                                    Click="OnProblemClicked"
                                                    Tag="{x:Bind}">
                                                    <TextBlock
                                                        FontFamily="Cascadia Mono,Consolas"
                                                        FontSize="12"
                                                        Text="{x:Bind FileLink}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </HyperlinkButton>
                                                <controls:PathText Text="{x:Bind Folder}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border
                        Style="{StaticResource FlushCardStyle}"
                        Visibility="{x:Bind ViewModel.IsMatrix, Mode=OneWay}">
                        <StackPanel>
                            <Grid Style="{StaticResource TableHeaderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Requirement" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource TableHeaderTextStyle}"
                                    Text="Business rules" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource TableHeaderTextStyle}"
                                    Text="Evidence" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource TableHeaderTextStyle}"
                                    Text="Decisions" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource TableHeaderTextStyle}"
                                    Text="Work packages" />
                                <TextBlock
                                    Grid.Column="5"
                                    Style="{StaticResource TableHeaderTextStyle}"
                                    Text="Tests" />
                            </Grid>
                            <ListView
                                x:Name="MatrixList"
                                AutomationProperties.Name="Traceability matrix"
                                IsItemClickEnabled="True"
                                ItemClick="OnRowClicked"
                                ItemContainerStyle="{StaticResource TableRowStyle}"
                                ItemsSource="{x:Bind ViewModel.Matrix, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MatrixRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <HyperlinkButton
                                                Padding="0"
                                                VerticalAlignment="Top"
                                                Click="OnRequirementClicked"
                                                Tag="{x:Bind}">
                                                <TextBlock
                                                    FontFamily="Cascadia Mono,Consolas"
                                                    FontSize="12"
                                                    Text="{x:Bind Id}" />
                                            </HyperlinkButton>
                                            <TextBlock
                                                Grid.Column="1"
                                                FontFamily="Cascadia Mono,Consolas"
                                                FontSize="12"
                                                Text="{x:Bind BusinessRules}"
                                                TextWrapping="Wrap" />
                                            <ItemsRepeater
                                                Grid.Column="2"
                                                ItemsSource="{x:Bind Evidence}"
                                                Visibility="{x:Bind HasEvidence}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <controls:EvidenceLink Reference="{x:Bind}" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="—"
                                                Visibility="{x:Bind HasNoEvidence}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                FontFamily="Cascadia Mono,Consolas"
                                                FontSize="12"
                                                Text="{x:Bind Decisions}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="4"
                                                FontFamily="Cascadia Mono,Consolas"
                                                FontSize="12"
                                                Text="{x:Bind WorkPackages}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="5"
                                                FontFamily="Cascadia Mono,Consolas"
                                                FontSize="12"
                                                Text="{x:Bind Tests}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasTests}" />
                                            <controls:StatusPill
                                                Grid.Column="5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                State="Warning"
                                                Text="None"
                                                Visibility="{x:Bind HasNoTests}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border
                                Padding="16,10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}">
                                    Rows appear as the functional requirements grow. A requirement with no test is a
                                    warning; one with no business rule and no evidence is an error.
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
