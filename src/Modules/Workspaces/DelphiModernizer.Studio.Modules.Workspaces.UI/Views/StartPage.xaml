<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Workspaces.UI.Views.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstractions="using:DelphiModernizer.Studio.Application.Abstractions"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.Workspaces.UI.ViewModels"
    Loaded="OnLoaded">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!--  Under 1100 (canvas StartMin): one column of compact action cards with their tiles,
                      the side cards below, and Recent workspaces without Last opened.  -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Spacing" Value="16" />
                        <Setter Target="Actions.ColumnSpacing" Value="0" />
                        <Setter Target="Actions.RowSpacing" Value="12" />
                        <Setter Target="ActionColumn2.Width" Value="0" />
                        <Setter Target="ActionColumn3.Width" Value="0" />
                        <Setter Target="OpenCard.(Grid.Row)" Value="1" />
                        <Setter Target="OpenCard.(Grid.Column)" Value="0" />
                        <Setter Target="CloneCard.(Grid.Row)" Value="2" />
                        <Setter Target="CloneCard.(Grid.Column)" Value="0" />
                        <Setter Target="NewCard.Padding" Value="12,10" />
                        <Setter Target="OpenCard.Padding" Value="12,10" />
                        <Setter Target="CloneCard.Padding" Value="12,10" />
                        <Setter Target="Columns.ColumnSpacing" Value="0" />
                        <Setter Target="Columns.RowSpacing" Value="16" />
                        <Setter Target="SideColumn.Width" Value="0" />
                        <Setter Target="Side.(Grid.Row)" Value="1" />
                        <Setter Target="Side.(Grid.Column)" Value="0" />
                        <Setter Target="LastOpened.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer>
            <controls:FullWidthStackPanel x:Name="PageContent" Style="{StaticResource PageContentStyle}">
                <controls:PageHeader
                    Purpose="Reopen a workspace, or start one from a Delphi source tree."
                    Title="Start" />

                <StackPanel Spacing="16">
                    <Grid
                        x:Name="Actions"
                        AutomationProperties.Name="Start a workspace"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ActionColumn2" Width="*" />
                            <ColumnDefinition x:Name="ActionColumn3" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="NewCard"
                            AutomationProperties.Name="New workspace"
                            Command="{x:Bind ViewModel.NewWorkspaceCommand}"
                            Style="{StaticResource ActionCardStyle}">
                            <AutomationProperties.HelpText>
                                Copy a Delphi source tree into a new private repository and plan its modernization.
                            </AutomationProperties.HelpText>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NewTile" Style="{StaticResource AccentTileStyle}">
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="{x:Bind icons:StudioIcons.Add}"
                                        Style="{StaticResource IconStyle}" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="New workspace" />
                                    <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}">
                                        Copy a Delphi source tree into a new private repository and plan its
                                        modernization.
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="OpenCard"
                            Grid.Column="1"
                            AutomationProperties.HelpText="Open a workspace folder that already holds modernizer.json."
                            AutomationProperties.Name="Open folder…"
                            Command="{x:Bind ViewModel.OpenFolderCommand}"
                            Style="{StaticResource ActionCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="OpenTile" Style="{StaticResource TileStyle}">
                                    <FontIcon
                                        FontSize="20"
                                        Glyph="{x:Bind icons:StudioIcons.OpenFolder}"
                                        Style="{StaticResource IconStyle}" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Open folder…" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="Open a workspace folder that already holds modernizer.json." />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!--  Clone from Git has no designed flow (docs/open-questions.md): its card is shown, off.  -->
                        <Button
                            x:Name="CloneCard"
                            Grid.Column="2"
                            AutomationProperties.HelpText="Clone a workspace repository your team already started."
                            AutomationProperties.Name="Clone from Git…"
                            IsEnabled="False"
                            Style="{StaticResource ActionCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CloneTile" Style="{StaticResource TileStyle}">
                                    <FontIcon
                                        FontSize="20"
                                        Glyph="{x:Bind icons:StudioIcons.Clone}"
                                        Style="{StaticResource IconStyle}" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Clone from Git…" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="Clone a workspace repository your team already started." />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>

                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                        Severity="Error"
                        Title="That workspace didn’t open."
                        Visibility="{x:Bind ViewModel.HasProblem, Mode=OneWay}">
                        <InfoBar.IconSource>
                            <FontIconSource
                                FontFamily="{StaticResource StudioIconsFontFamily}"
                                Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                        </InfoBar.IconSource>
                    </InfoBar>

                    <Grid x:Name="Columns" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SideColumn" Width="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border VerticalAlignment="Top" Style="{StaticResource FlushCardStyle}">
                            <StackPanel>
                                <!--  Canvas .card-h: the header is its padding and one line of text, with no button.  -->
                                <Grid MinHeight="0" Style="{StaticResource CardHeaderStyle}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Recent workspaces" />
                                </Grid>

                                <StackPanel Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}">
                                    <Grid Style="{StaticResource TableHeaderStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource TableHeaderTextStyle}"
                                            Text="Name and folder" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource TableHeaderTextStyle}"
                                            Text="Target" />
                                        <TextBlock
                                            x:Name="LastOpened"
                                            Grid.Column="2"
                                            Width="132"
                                            Style="{StaticResource TableHeaderTextStyle}"
                                            Text="Last opened" />
                                    </Grid>
                                    <ListView
                                        AutomationProperties.Name="Recent workspaces"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnRecentClicked"
                                        ItemContainerStyle="{StaticResource TableRowStyle}"
                                        ItemsSource="{x:Bind ViewModel.Recent}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentWorkspaceRow">
                                                <Grid
                                                    AutomationProperties.Name="{x:Bind AnnouncedName}"
                                                    ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <!--  Canvas .trow: a 20 tall name line over the 16 path line.  -->
                                                        <TextBlock
                                                            LineHeight="20"
                                                            LineStackingStrategy="BlockLineHeight"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind Name}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            Style="{StaticResource MonoTextStyle}"
                                                            Text="{x:Bind Root}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource TagStyle}">
                                                        <TextBlock
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Target}"
                                                            TextLineBounds="Tight" />
                                                    </Border>
                                                    <!--  The header decides, so it hides in every row under 1100.  -->
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Width="132"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="{x:Bind OpenedAt}"
                                                        Visibility="{Binding Visibility, ElementName=LastOpened}" />
                                                    <!--  Canvas .t-recent: the chevron starts its 32 column.  -->
                                                    <FontIcon
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Left"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="{x:Bind icons:StudioIcons.ChevronRight}"
                                                        Style="{StaticResource IconStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <controls:EmptyState
                                    Glyph="{x:Bind icons:StudioIcons.Folder}"
                                    Title="No recent workspaces"
                                    Visibility="{x:Bind ViewModel.HasNoRecent, Mode=OneWay}">
                                    <controls:EmptyState.Message>
                                        Start one from a Delphi source tree, or open a workspace your team shared. Each
                                        workspace is a private git repository; nothing leaves your machine unless you
                                        push it.
                                    </controls:EmptyState.Message>
                                </controls:EmptyState>
                            </StackPanel>
                        </Border>

                        <StackPanel
                            x:Name="Side"
                            Grid.Column="1"
                            Spacing="16">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel
                                    AutomationProperties.Name="{x:Bind ViewModel.Claude.AnnouncedName, Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind icons:StudioIcons.ClaudeCode}"
                                            Style="{StaticResource IconStyle}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.HeadingLevel="Level2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Claude Code" />
                                        <controls:StatusPill
                                            Grid.Column="2"
                                            State="{x:Bind ViewModel.Claude.Pill, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.Claude.HasStatus, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Claude.Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource MonoTextStyle}"
                                        Text="{x:Bind ViewModel.Claude.Path, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.Claude.HasPath, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind ViewModel.Claude.Note, Mode=OneWay}" />
                                    <HyperlinkButton
                                        Margin="-11,8,0,0"
                                        AutomationProperties.HelpText="{x:Bind ViewModel.Claude.AnnouncedName,
                                            Mode=OneWay}"
                                        Click="OnClaudeLinkClicked"
                                        Content="{x:Bind ViewModel.Claude.Link, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.Claude.HasLink, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="Versions" />
                                    <!--  Canvas .kv: 11 px mono values on their labels' baseline make each row 17 tall,
                                          and the list keeps its 12 bottom margin.  -->
                                    <Grid
                                        Margin="0,0,0,12"
                                        ColumnSpacing="16"
                                        RowSpacing="8">
                                        <Grid.Resources>
                                            <Style
                                                x:Key="VersionValueStyle"
                                                BasedOn="{StaticResource MonoTextStyle}"
                                                TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0,0,0,5" />
                                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Property="IsTextSelectionEnabled" Value="True" />
                                                <Setter Property="TextLineBounds" Value="Tight" />
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="17" />
                                            <RowDefinition Height="17" />
                                            <RowDefinition Height="17" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Studio" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource VersionValueStyle}"
                                            Text="{x:Bind abstractions:StudioVersions.Current.Studio}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="Engine (dmz)" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource VersionValueStyle}"
                                            Text="{x:Bind abstractions:StudioVersions.Current.Engine}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="Kit" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{StaticResource VersionValueStyle}"
                                            Text="{x:Bind abstractions:StudioVersions.Current.Kit}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:FullWidthStackPanel>
        </ScrollViewer>
    </Grid>
</Page>
