<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Workspaces.UI.Views.NewWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:settings="using:DelphiModernizer.Studio.Application.Abstractions.Settings"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.Workspaces.UI.ViewModels"
    Loaded="OnLoaded">

    <Page.Resources>
        <!--  A target choice reads as a card: the radio, its name and what choosing it writes.  -->
        <Style
            x:Key="ChoiceStyle"
            BasedOn="{StaticResource DefaultRadioButtonStyle}"
            TargetType="RadioButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <!--  The card's padding, 12 and 16; the template moves the content 6 down so the radio centres on its title.  -->
            <Setter Property="Padding" Value="16,6,16,12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <!--  WinUI's template, with the padding around the radio as well as the text (canvas: the radio inside the card,
                  12 to the text) and without the pointer states that clear the card's background and border.  -->
            <Setter Property="Template">
                <Setter.Value>
                      <ControlTemplate TargetType="RadioButton">
                          <Grid x:Name="RootGrid"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                     Padding="{TemplateBinding Padding}">

                              <VisualStateManager.VisualStateGroups>
                                  <VisualStateGroup x:Name="CommonStates">
                                      <VisualState x:Name="Normal">

                                          <Storyboard>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseStroke}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseFill}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckOuterEllipse" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseCheckedStroke}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckOuterEllipse" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseCheckedFill}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphFill}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphStroke}" />
                                              </ObjectAnimationUsingKeyFrames>
                                          </Storyboard>
                                      </VisualState>

                                      <VisualState x:Name="PointerOver">

                                          <Storyboard>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonForegroundPointerOver}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseStrokePointerOver}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseFillPointerOver}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckOuterEllipse" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseCheckedStrokePointerOver}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckOuterEllipse" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseCheckedFillPointerOver}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphFillPointerOver}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphStrokePointerOver}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                                  <SplineDoubleKeyFrame KeyTime="{StaticResource ControlNormalAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="14" />
                                              </DoubleAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                                  <SplineDoubleKeyFrame KeyTime="{StaticResource ControlNormalAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="14" />
                                              </DoubleAnimationUsingKeyFrames>
                                          </Storyboard>
                                      </VisualState>

                                      <VisualState x:Name="Pressed">

                                          <Storyboard>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonForegroundPressed}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseStrokePressed}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseFillPressed}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckOuterEllipse" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseCheckedStrokePressed}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckOuterEllipse" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseCheckedFillPressed}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphFillPressed}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphStrokePressed}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                                  <SplineDoubleKeyFrame KeyTime="{StaticResource ControlNormalAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="10" />
                                              </DoubleAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                                  <SplineDoubleKeyFrame KeyTime="{StaticResource ControlNormalAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="10" />
                                              </DoubleAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressedCheckGlyph" Storyboard.TargetProperty="Opacity">
                                                  <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                                              </DoubleAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressedCheckGlyph" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                                  <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="10" />
                                              </DoubleAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressedCheckGlyph" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                                  <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="10" />
                                              </DoubleAnimationUsingKeyFrames>
                                          </Storyboard>
                                      </VisualState>

                                      <VisualState x:Name="Disabled">

                                          <Storyboard>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonForegroundDisabled}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseStrokeDisabled}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseFillDisabled}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckOuterEllipse" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseCheckedStrokeDisabled}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckOuterEllipse" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonOuterEllipseCheckedFillDisabled}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Fill">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphFillDisabled}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphStrokeDisabled}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                                  <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="14" />
                                              </DoubleAnimationUsingKeyFrames>
                                              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Height" EnableDependentAnimation="True">
                                                  <SplineDoubleKeyFrame KeyTime="{StaticResource ControlFastAnimationDuration}" KeySpline="{StaticResource ControlFastOutSlowInKeySpline}" Value="14" />
                                              </DoubleAnimationUsingKeyFrames>
                                          </Storyboard>
                                      </VisualState>

                                  </VisualStateGroup>
                                  <VisualStateGroup x:Name="CheckStates">

                                      <VisualState x:Name="Checked">

                                          <Storyboard>
                                              <DoubleAnimation Storyboard.TargetName="CheckGlyph"
                              Storyboard.TargetProperty="Opacity"
                              To="1"
                              Duration="0" />
                                              <DoubleAnimation Storyboard.TargetName="OuterEllipse"
                              Storyboard.TargetProperty="Opacity"
                              To="0"
                              Duration="0" />
                                              <DoubleAnimation Storyboard.TargetName="CheckOuterEllipse"
                              Storyboard.TargetProperty="Opacity"
                              To="1"
                              Duration="0" />
                                              <DoubleAnimation Storyboard.TargetName="PressedCheckGlyph" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Stroke">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphStrokeChecked}" />
                                              </ObjectAnimationUsingKeyFrames>
                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PressedCheckGlyph" Storyboard.TargetProperty="Background">
                                                  <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource RadioButtonCheckGlyphFillPressed}" />
                                              </ObjectAnimationUsingKeyFrames>
                                          </Storyboard>
                                      </VisualState>
                                      <VisualState x:Name="Unchecked" />
                                      <VisualState x:Name="Indeterminate" />

                                  </VisualStateGroup>

                              </VisualStateManager.VisualStateGroups>

                              <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="20" />
                                  <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>

                              <Grid VerticalAlignment="Top" Height="32">
                                  <Ellipse x:Name="OuterEllipse" Width="20" Height="20" UseLayoutRounding="False" Stroke="{ThemeResource RadioButtonOuterEllipseStroke}" Fill="{ThemeResource RadioButtonOuterEllipseFill}" StrokeThickness="{ThemeResource RadioButtonBorderThemeThickness}" />
                                  <!-- A seperate element is added since the two orthogonal state groups that cannot touch the same property -->
                                  <Ellipse x:Name="CheckOuterEllipse"
                        Width="20"
                        Height="20"
                        UseLayoutRounding="False"
                        Stroke="{ThemeResource RadioButtonOuterEllipseCheckedStroke}"
                        Fill="{ThemeResource RadioButtonOuterEllipseCheckedFill}"
                        Opacity="0"
                        StrokeThickness="{ThemeResource RadioButtonBorderThemeThickness}" />
                                  <Ellipse x:Name="CheckGlyph" Width="{ThemeResource RadioButtonCheckGlyphSize}" Height="{ThemeResource RadioButtonCheckGlyphSize}" UseLayoutRounding="False" Opacity="0" Fill="{ThemeResource RadioButtonCheckGlyphFill}" Stroke="{ThemeResource RadioButtonCheckGlyphStroke}" />
                                  <!-- A seperate element is added since the two orthogonal state groups that cannot touch the same property -->
                                  <Border x:Name="PressedCheckGlyph" Width="4" Height="4" CornerRadius="6" UseLayoutRounding="False" Opacity="0" Background="{ThemeResource RadioButtonCheckGlyphFill}" BackgroundSizing="OuterBorderEdge" BorderBrush="{ThemeResource RadioButtonCheckGlyphStroke}" />

                              </Grid>
                              <ContentPresenter x:Name="ContentPresenter"
                      Content="{TemplateBinding Content}"
                      ContentTransitions="{TemplateBinding ContentTransitions}"
                      ContentTemplate="{TemplateBinding ContentTemplate}"
                      Foreground="{TemplateBinding Foreground}"
                      Margin="12,6,0,0"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                      Grid.Column="1"
                      AutomationProperties.AccessibilityView="Raw"
                      TextWrapping="Wrap" />

                          </Grid>

                      </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Canvas .choice.on: a 1 border and a 1 ring in the accent, so the content does not move.  -->
        <Style
            x:Key="ChosenChoiceStyle"
            BasedOn="{StaticResource ChoiceStyle}"
            TargetType="RadioButton">
            <Setter Property="Padding" Value="15,5,15,11" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates" CurrentStateChanged="OnWidthStateChanged">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!--  Under 1100 the steps run across the top in five columns and the preview has two.  -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Spacing" Value="16" />
                        <Setter Target="Layout.ColumnSpacing" Value="0" />
                        <Setter Target="Layout.RowSpacing" Value="12" />
                        <Setter Target="StepColumn.Width" Value="*" />
                        <Setter Target="FormColumn.Width" Value="0" />
                        <Setter Target="FormCard.(Grid.Row)" Value="1" />
                        <Setter Target="FormCard.(Grid.Column)" Value="0" />
                        <Setter Target="StepsLayout.MaximumRowsOrColumns" Value="5" />
                        <Setter Target="FactsLayout.MaximumRowsOrColumns" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer x:Name="PageScroller">
            <controls:FullWidthStackPanel x:Name="PageContent" Style="{StaticResource PageContentStyle}">
                <controls:PageHeader
                    Purpose="Five steps. Nothing is written to disk until you choose Create."
                    Title="New workspace" />

                <Grid x:Name="Layout" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StepColumn" Width="208" />
                        <ColumnDefinition x:Name="FormColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Not a tab stop: the step heading inside the card says where the person is.  -->
                    <ItemsRepeater
                        x:Name="StepsRepeater"
                        VerticalAlignment="Top"
                        AutomationProperties.AccessibilityView="Raw"
                        ElementPrepared="OnStepPrepared"
                        ItemsSource="{x:Bind ViewModel.Steps}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                x:Name="StepsLayout"
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="1"
                                MinColumnSpacing="4"
                                MinItemHeight="40"
                                MinItemWidth="96"
                                MinRowSpacing="2"
                                Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:WizardStep">
                                <Grid
                                    Padding="8,4"
                                    ColumnSpacing="12"
                                    CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.ColumnSpan="2"
                                        Margin="-8,-4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="12"
                                        Visibility="{x:Bind IsDone, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Glyph="{x:Bind icons:StudioIcons.Checkmark}"
                                            Style="{StaticResource IconStyle}" />
                                    </Border>
                                    <Border
                                        Width="24"
                                        Height="24"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2"
                                        CornerRadius="12"
                                        Visibility="{x:Bind IsCurrent, Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind NumberText}" />
                                    </Border>
                                    <Border
                                        Width="24"
                                        Height="24"
                                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Visibility="{x:Bind IsTodo, Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind NumberText}" />
                                    </Border>
                                    <!--  Canvas: the current step semibold, the steps ahead in secondary text.  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Label}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Label}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Label}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind IsTodo, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border
                        x:Name="FormCard"
                        Grid.Column="1"
                        Padding="24,20,24,24"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <!--  The heading reads with its step number and takes focus on Next and Back.  -->
                            <StackPanel>
                                <TextBlock
                                    AutomationProperties.AccessibilityView="Raw"
                                    Style="{StaticResource SecondaryCaptionTextStyle}"
                                    Text="{x:Bind ViewModel.StepOf, Mode=OneWay}" />
                                <!--  Focusable without text selection: a focused selectable TextBlock whose text changes
                                      can stop drawing it.  -->
                                <ContentControl
                                    x:Name="StepHeading"
                                    AutomationProperties.HeadingLevel="Level2"
                                    AutomationProperties.Name="{x:Bind ViewModel.StepHeading, Mode=OneWay}"
                                    IsTabStop="True"
                                    UseSystemFocusVisuals="False">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}" />
                                </ContentControl>
                            </StackPanel>

                            <!--  Step 1: name and folder.  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsStep1, Mode=OneWay}">
                                <TextBox
                                    x:Name="NameBox"
                                    AutomationProperties.IsRequiredForForm="True"
                                    Header="Workspace name"
                                    Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <!--  Canvas .fld: 8 between the folder row, its error and its help.  -->
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="FolderBox"
                                            AutomationProperties.HelpText="{x:Bind ViewModel.FolderProblem,
                                                Mode=OneWay}"
                                            AutomationProperties.IsRequiredForForm="True"
                                            Header="Folder"
                                            Text="{x:Bind ViewModel.Folder, Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />
                                        <Border
                                            Style="{StaticResource InvalidUnderlineStyle}"
                                            Visibility="{x:Bind ViewModel.HasFolderProblem, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Command="{x:Bind ViewModel.BrowseFolderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon
                                                    Glyph="{x:Bind icons:StudioIcons.OpenFolder}"
                                                    Style="{StaticResource IconStyle}" />
                                                <TextBlock Text="Browse…" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasFolderProblem, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Top"
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="{x:Bind icons:StudioIcons.ErrorFilled}"
                                            Style="{StaticResource IconStyle}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.FolderProblem, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="A new or empty folder. It becomes the workspace’s git repository." />
                                </StackPanel>
                                <InfoBar
                                    IsClosable="False"
                                    IsOpen="True"
                                    Severity="Warning"
                                    Title="Keep this repository private.">
                                    <InfoBar.Message>
                                        It will hold a copy of your legacy source, which can contain credentials,
                                        customer data and business rules.
                                    </InfoBar.Message>
                                    <InfoBar.IconSource>
                                        <FontIconSource
                                            FontFamily="{StaticResource StudioIconsFontFamily}"
                                            Glyph="{x:Bind icons:StudioIcons.WarningFilled}" />
                                    </InfoBar.IconSource>
                                </InfoBar>
                            </StackPanel>

                            <!--  Step 2: the legacy source, its code page and a read-only preview.  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsStep2, Mode=OneWay}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="LegacyBox"
                                            AutomationProperties.IsRequiredForForm="True"
                                            Header="Legacy source folder"
                                            LostFocus="OnLegacySourceLostFocus"
                                            Text="{x:Bind ViewModel.LegacySource, Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Command="{x:Bind ViewModel.BrowseLegacyCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon
                                                    Glyph="{x:Bind icons:StudioIcons.OpenFolder}"
                                                    Style="{StaticResource IconStyle}" />
                                                <TextBlock Text="Browse…" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="Copied read-only into legacy/. The original folder isn’t changed." />
                                </StackPanel>
                                <ComboBox
                                    MinWidth="360"
                                    DisplayMemberPath="Label"
                                    Header="Code page for files without a byte-order mark"
                                    ItemsSource="{x:Bind settings:CodePages.Common}"
                                    SelectedItem="{x:Bind ViewModel.SelectedCodePage, Mode=TwoWay}" />

                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsPreviewDone, Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Preview" />
                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryCaptionTextStyle}">
                                            A quick scan. Numbers are findings to confirm, not compiler output.
                                        </TextBlock>
                                    </Grid>
                                    <Border
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Facts}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout
                                                    x:Name="FactsLayout"
                                                    ItemsStretch="Fill"
                                                    MaximumRowsOrColumns="3"
                                                    MinItemWidth="160"
                                                    Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PreviewFact">
                                                    <Border
                                                        Padding="0,10,12,10"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1">
                                                        <StackPanel>
                                                            <TextBlock
                                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                                Text="{x:Bind Label}" />
                                                            <TextBlock
                                                                Style="{StaticResource BodyTextBlockStyle}"
                                                                Text="{x:Bind Value}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Border>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind ViewModel.HasCredentials, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind icons:StudioIcons.Secret}"
                                            Style="{StaticResource IconStyle}" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryCaptionTextStyle}"
                                            Text="{x:Bind ViewModel.CredentialsNote, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    AutomationProperties.LiveSetting="Polite"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsPreviewRunning, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Preview" />
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:Spinner
                                                    VerticalAlignment="Center"
                                                    IsActive="{x:Bind ViewModel.IsPreviewRunning, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind ViewModel.ScanText, Mode=OneWay}" />
                                            </StackPanel>
                                            <ProgressBar Value="{x:Bind ViewModel.ScanPercent, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}">
                                                You can keep going once the preview finishes; it takes a few seconds for
                                                most trees.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!--  Collapsed while closed: a closed InfoBar still takes its stack's spacing.  -->
                                <InfoBar
                                    AutomationProperties.LiveSetting="Polite"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.IsPreviewFailed, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsPreviewFailed, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.PreviewProblem, Mode=OneWay}"
                                    Severity="Error"
                                    Title="Couldn’t preview this folder.">
                                    <InfoBar.IconSource>
                                        <FontIconSource
                                            FontFamily="{StaticResource StudioIconsFontFamily}"
                                            Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                                    </InfoBar.IconSource>
                                    <InfoBar.ActionButton>
                                        <Button Command="{x:Bind ViewModel.PreviewCommand}" Content="Try again" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </StackPanel>

                            <!--  Step 3: the target platform; only a person chooses it.  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsStep3, Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap">
                                    Choose the target now or after discovery. Only a person picks the platform; agents
                                    are refused.
                                </TextBlock>
                                <RadioButtons
                                    x:Name="TargetChoices"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Target platform"
                                    Loaded="OnTargetChoicesChanged"
                                    SelectedIndex="{x:Bind ViewModel.TargetIndex, Mode=TwoWay}"
                                    SelectionChanged="OnTargetChoicesChanged">
                                    <RadioButtons.Resources>
                                        <!--  WinUI leaves 8 below the empty header; the board has none.  -->
                                        <Thickness x:Key="RadioButtonsTopHeaderMargin">0</Thickness>
                                    </RadioButtons.Resources>
                                    <RadioButton Style="{StaticResource ChoiceStyle}">
                                        <AutomationProperties.Name>
                                            C#/.NET. Writes DEC-001 to the decision log with you as the decider.
                                        </AutomationProperties.Name>
                                        <controls:FullWidthStackPanel Spacing="2">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="C#/.NET" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="Recorded in the decision log, with you as the decider." />
                                        </controls:FullWidthStackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ChoiceStyle}">
                                        <AutomationProperties.Name>
                                            Java/JVM. Writes DEC-001 to the decision log with you as the decider.
                                        </AutomationProperties.Name>
                                        <controls:FullWidthStackPanel Spacing="2">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="Java/JVM" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="Recorded in the decision log, with you as the decider." />
                                        </controls:FullWidthStackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ChoiceStyle}">
                                        <AutomationProperties.Name>
                                            Decide after discovery. Adds an open question; the Architecture sign-off
                                            stays blocked until someone decides.
                                        </AutomationProperties.Name>
                                        <controls:FullWidthStackPanel Spacing="2">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="Decide after discovery" />
                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}">
                                                Adds an open question. The Architecture sign-off stays blocked until
                                                someone decides.
                                            </TextBlock>
                                        </controls:FullWidthStackPanel>
                                    </RadioButton>
                                </RadioButtons>
                                <StackPanel MaxWidth="420" HorizontalAlignment="Left" Spacing="4">
                                    <TextBox
                                        MinWidth="420"
                                        AutomationProperties.IsRequiredForForm="True"
                                        Header="Decided by"
                                        Text="{x:Bind ViewModel.DecidedBy, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="Recorded in the decision log." />
                                </StackPanel>
                            </StackPanel>

                            <!--  Step 4: the essential context; Unknown is an answer and becomes a question.  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsStep4, Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap">
                                    Fill what you know. Each field left as Unknown becomes an open question in
                                    docs/00-project-charter/open-questions.md.
                                </TextBlock>
                                <Grid
                                    MinHeight="36"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Field" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource TableHeaderTextStyle}"
                                        Text="Value" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Context}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="16" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ContextField">
                                            <Grid
                                                MinHeight="44"
                                                Padding="0,6"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="112" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Label}" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                                    <TextBox
                                                        AutomationProperties.Name="{x:Bind Label}"
                                                        IsReadOnly="{x:Bind IsUnknown, Mode=OneWay}"
                                                        PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
                                                        Text="{x:Bind Value, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock
                                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                                        Text="Becomes an open question."
                                                        Visibility="{x:Bind IsUnknown, Mode=OneWay}" />
                                                </StackPanel>
                                                <CheckBox
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{x:Bind UnknownName}"
                                                    Content="Unknown"
                                                    IsChecked="{x:Bind IsUnknown, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <!--  Step 5: what will be written, then Create.  -->
                            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsStep5, Mode=OneWay}">
                                <!--  The Wizard board leaves 32 between the step's title and its summary.  -->
                                <Grid
                                    Margin="0,16,0,0"
                                    ColumnSpacing="16"
                                    RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}" Text="Name" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="Folder" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Style="{StaticResource MonoTextStyle}"
                                        Text="{x:Bind ViewModel.Folder, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="Legacy source" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.LegacySummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="Target platform" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.TargetSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="Context" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind ViewModel.ContextSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <!--  Canvas WizardStep5 leaves about 57 between the summary and the checkbox text.  -->
                                <CheckBox
                                    Margin="0,16,0,0"
                                    Content="Initialise git and make the first commit"
                                    IsChecked="{x:Bind ViewModel.InitializeGit, Mode=TwoWay}" />
                                <InfoBar
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="Push it only to a private remote your organisation controls."
                                    Severity="Warning"
                                    Title="Keep this repository private.">
                                    <InfoBar.IconSource>
                                        <FontIconSource
                                            FontFamily="{StaticResource StudioIconsFontFamily}"
                                            Glyph="{x:Bind icons:StudioIcons.WarningFilled}" />
                                    </InfoBar.IconSource>
                                </InfoBar>
                                <!--  Collapsed while closed: a closed InfoBar still takes its stack's spacing.  -->
                                <InfoBar
                                    AutomationProperties.LiveSetting="Polite"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.HasCreateProblem, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasCreateProblem, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.CreateProblem, Mode=OneWay}"
                                    Severity="Error"
                                    Title="The workspace wasn’t created.">
                                    <InfoBar.IconSource>
                                        <FontIconSource
                                            FontFamily="{StaticResource StudioIconsFontFamily}"
                                            Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                                    </InfoBar.IconSource>
                                </InfoBar>
                            </StackPanel>

                            <!--  Creating: each step as the engine reports it.  -->
                            <ItemsRepeater
                                AutomationProperties.Name="Creating the workspace"
                                ItemsSource="{x:Bind ViewModel.Creation}"
                                Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CreationStepRow">
                                        <Grid
                                            Padding="0,10"
                                            AutomationProperties.Name="{x:Bind AnnouncedName, Mode=OneWay}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Spinner
                                                IsActive="{x:Bind IsWorking, Mode=OneWay}"
                                                Visibility="{x:Bind IsWorking, Mode=OneWay}" />
                                            <FontIcon
                                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                Glyph="{x:Bind icons:StudioIcons.CheckPassed}"
                                                Style="{StaticResource IconStyle}"
                                                Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                            <FontIcon
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Glyph="{x:Bind icons:StudioIcons.ErrorFilled}"
                                                Style="{StaticResource IconStyle}"
                                                Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                            <FontIcon
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind icons:StudioIcons.NotYet}"
                                                Style="{StaticResource IconStyle}"
                                                Visibility="{x:Bind IsWaiting, Mode=OneWay}" />
                                            <!--  Canvas: a step still waiting reads in secondary text.  -->
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind Label, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind IsStarted, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Text="{x:Bind Label, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind IsWaiting, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="{x:Bind StatusText, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!--  Created.  -->
                            <StackPanel
                                Padding="16,32"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.IsCreated, Mode=OneWay}">
                                <FontIcon
                                    Margin="0,0,0,4"
                                    FontSize="48"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind icons:StudioIcons.Ready}"
                                    Style="{StaticResource IconStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level3"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CreatedTitle, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <!--  Canvas .empty p: secondary text, at most 44 characters wide.  -->
                                <TextBlock
                                    MaxWidth="368"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CreatedText, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="OpenOverviewButton"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.OpenOverviewCommand}"
                                    Content="Open the Overview"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>

                            <Grid
                                Padding="0,4,0,0"
                                ColumnSpacing="8"
                                Visibility="{x:Bind ViewModel.HasFooter, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--  Tab order follows the markup: Back, Next or Create, then Cancel on the left.  -->
                                <Button
                                    Grid.Column="2"
                                    Command="{x:Bind ViewModel.BackCommand}"
                                    Content="Back"
                                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
                                <Button
                                    Grid.Column="3"
                                    Command="{x:Bind ViewModel.NextCommand}"
                                    Content="{x:Bind ViewModel.NextLabel, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Command="{x:Bind ViewModel.CancelCommand}"
                                    Content="Cancel"
                                    IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:FullWidthStackPanel>
        </ScrollViewer>
    </Grid>
</Page>
