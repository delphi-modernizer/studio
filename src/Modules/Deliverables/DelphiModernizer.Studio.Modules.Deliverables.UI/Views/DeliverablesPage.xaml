<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DelphiModernizer.Studio.Modules.Deliverables.UI.Views.DeliverablesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.Deliverables.UI.ViewModels"
    Loaded="OnLoaded">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <controls:PageHeader Purpose="The 20 documents of the modernization plan: which team drafts each one, which sign-off needs it, and where it stands." Title="Deliverables">
                <controls:PageHeader.Actions>
                    <Button Click="OnOpenDocs" Visibility="{x:Bind ViewModel.HasWorkspace, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:StudioIcons.OpenFolder}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="Open docs/" />
                        </StackPanel>
                    </Button>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <controls:NoWorkspaceState
                Glyph="{x:Bind icons:StudioIcons.Deliverables}"
                Message="Deliverables lists a workspace’s 20 documents: which team drafts each one, which sign-off needs it, and where it stands. Open or start a workspace to see them."
                Visibility="{x:Bind ViewModel.HasNoWorkspace, Mode=OneWay}" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                Severity="Error"
                Title="Couldn’t read the deliverables.">
                <InfoBar.IconSource>
                    <FontIconSource FontFamily="{StaticResource StudioIconsFontFamily}" Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                </InfoBar.IconSource>
            </InfoBar>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.AllTemplates, Mode=OneWay}"
                    Message="Write them yourself, or run a team’s agent task so an agent drafts them for you to review."
                    Severity="Informational"
                    Title="Every deliverable is still a template.">
                    <InfoBar.IconSource>
                        <FontIconSource FontFamily="{StaticResource StudioIconsFontFamily}" Glyph="{x:Bind icons:StudioIcons.InfoFilled}" />
                    </InfoBar.IconSource>
                    <InfoBar.ActionButton>
                        <Button Click="OnGoToWorkstreams" Content="Go to Workstreams" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasMissing, Mode=OneWay}"
                    Message="{x:Bind ViewModel.MissingMessage, Mode=OneWay}"
                    Severity="Error"
                    Title="{x:Bind ViewModel.MissingTitle, Mode=OneWay}">
                    <InfoBar.IconSource>
                        <FontIconSource FontFamily="{StaticResource StudioIconsFontFamily}" Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
                    </InfoBar.IconSource>
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind ViewModel.RestoreCommand}" Content="Restore from template" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <SelectorBar
                    x:Name="FilterBar"
                    AutomationProperties.Name="Filter by status"
                    SelectionChanged="OnFilterChanged" />

                <Border Style="{StaticResource FlushCardStyle}">
                    <StackPanel AutomationProperties.Name="Deliverables">
                        <Grid Style="{StaticResource TableHeaderStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Deliverable and file" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource TableHeaderTextStyle}"
                                Text="Drafted by" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource TableHeaderTextStyle}"
                                Text="Status" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SignOffGroup">
                                    <StackPanel>
                                        <Grid
                                            MinHeight="36"
                                            Padding="16,6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryCaptionTextStyle}"
                                                Text="{x:Bind Number}" />
                                            <controls:StatusPill Grid.Column="2" State="{x:Bind Pill}" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DeliverableRow">
                                                    <Grid
                                                        MinHeight="44"
                                                        Padding="16,6"
                                                        AutomationProperties.Name="{x:Bind AnnouncedName}"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="168" />
                                                            <ColumnDefinition Width="112" />
                                                            <ColumnDefinition Width="32" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock
                                                                Style="{StaticResource BodyTextBlockStyle}"
                                                                Text="{x:Bind Title}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />
                                                            <TextBlock Style="{StaticResource MonoTextStyle}" Text="{x:Bind Path}" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Owner}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <controls:StatusPill
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            State="{x:Bind Pill}" />
                                                        <Button
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{x:Bind OpenName}"
                                                            Click="OnOpenDeliverable"
                                                            IsEnabled="{x:Bind CanOpen}"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="Open in your editor">
                                                            <FontIcon Glyph="{x:Bind icons:StudioIcons.OpenInEditor}" Style="{StaticResource IconStyle}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Approved shows only while the sign-off’s approval is current. Status is read from each file; agents can move a file to Draft, never to Approved." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
