<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="DelphiModernizer.Studio.Modules.SignOffs.UI.Views.ApprovalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    xmlns:vm="using:DelphiModernizer.Studio.Modules.SignOffs.UI.ViewModels"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonText="Cancel"
    DefaultButton="None"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!--  548 wide with the dialog's 24 padding on each side.  -->
    <StackPanel Width="500" Spacing="16">
        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind ViewModel.Lead}"
            TextWrapping="Wrap" />

        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsFinalPlan}"
            Severity="Warning"
            Title="This allows building the new system."
            Visibility="{x:Bind ViewModel.IsFinalPlan}">
            <InfoBar.Message>
                Agents may then write the new code under target/ until a document the final plan covers changes, or
                someone revokes this approval.
            </InfoBar.Message>
            <InfoBar.IconSource>
                <FontIconSource
                    FontFamily="{StaticResource StudioIconsFontFamily}"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="{x:Bind icons:StudioIcons.WarningFilled}" />
            </InfoBar.IconSource>
        </InfoBar>

        <InfoBar
            x:Name="RefusalBar"
            AutomationProperties.LiveSetting="Assertive"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsRefused, Mode=OneWay}"
            Message="{x:Bind ViewModel.Refusal, Mode=OneWay}"
            Severity="Error"
            Title="Approval refused."
            Visibility="{x:Bind ViewModel.IsRefused, Mode=OneWay}">
            <InfoBar.IconSource>
                <FontIconSource
                    FontFamily="{StaticResource StudioIconsFontFamily}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="{x:Bind icons:StudioIcons.ErrorFilled}" />
            </InfoBar.IconSource>
            <InfoBar.ActionButton>
                <Button
                    x:Name="ShowProblemsButton"
                    Content="Show the problems"
                    Visibility="{x:Bind ViewModel.RefusalShowsProblems, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsRevoke}">
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Current approval" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    FontSize="20"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="{x:Bind icons:StudioIcons.Approved}"
                    Style="{StaticResource IconStyle}" />
                <StackPanel Grid.Column="1">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.SignOff.ApprovedBy}" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind ViewModel.SignOff.ApprovedWhen}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel
            AutomationProperties.Name="{x:Bind ViewModel.AnnouncedApprover}"
            Spacing="4"
            Visibility="{x:Bind ViewModel.HasIdentity}">
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ViewModel.AsLabel}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="32"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <FontIcon
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind icons:StudioIcons.Person}"
                        Style="{StaticResource IconStyle}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ApproverName}" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionTextStyle}"
                        Text="{x:Bind ViewModel.ApproverDetail}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasNoIdentity}">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.NoIdentityMessage}"
                Severity="Warning"
                Title="No git identity.">
                <InfoBar.IconSource>
                    <FontIconSource
                        FontFamily="{StaticResource StudioIconsFontFamily}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="{x:Bind icons:StudioIcons.WarningFilled}" />
                </InfoBar.IconSource>
            </InfoBar>
            <!--  The stroke keeps the box visible in high contrast, where the subtle fill is transparent.  -->
            <Border
                Padding="10,8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource MonoTextStyle}"
                    TextTrimming="None">
                    <Run Text="git config user.name &quot;Your Name&quot;" />
                    <LineBreak />
                    <Run Text="git config user.email you@example.com" />
                </TextBlock>
            </Border>
        </StackPanel>

        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsApprove}">
            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Covers" />
            <!--  Every covered file, as drawn: the list is short, and the dialog scrolls as a whole.  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SignOff.Covers}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:CoveredFileRow">
                        <TextBlock
                            Padding="0,1"
                            AutomationProperties.Name="{x:Bind Path}"
                            LineHeight="18"
                            Style="{StaticResource MonoTextStyle}"
                            Text="{x:Bind PathText}"
                            TextTrimming="None"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <!--  Whole, as drawn: the hash wraps anywhere, so it starts beside its label.  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind icons:StudioIcons.Fingerprint}"
                    Style="{StaticResource IconStyle}" />
                <TextBlock
                    Grid.Column="1"
                    AutomationProperties.Name="{x:Bind ViewModel.SignOff.FingerprintName}"
                    Style="{StaticResource SecondaryCaptionTextStyle}"
                    TextWrapping="Wrap">
                    <Run Text="Fingerprint of these files:" />
                    <Run FontFamily="Cascadia Mono,Consolas" Text="{x:Bind ViewModel.SignOff.FingerprintText}" />
                </TextBlock>
            </Grid>
        </StackPanel>

        <!--  As drawn: 76 tall, and open without an identity too; Approve stays off until git names who approves.  -->
        <StackPanel Spacing="8">
            <TextBlock>
                <Run Text="{x:Bind ViewModel.FieldLabel}" />
                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="(required)" />
            </TextBlock>
            <TextBox
                x:Name="NoteBox"
                MinHeight="76"
                AcceptsReturn="True"
                AutomationProperties.IsRequiredForForm="True"
                AutomationProperties.Name="{x:Bind ViewModel.FieldName}"
                PlaceholderText="{x:Bind ViewModel.Placeholder}"
                Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind ViewModel.Fine}"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
