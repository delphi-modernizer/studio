<UserControl
    x:Class="DelphiModernizer.Studio.UI.Common.Controls.NoWorkspaceState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DelphiModernizer.Studio.UI.Common.Controls"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons">

    <!--  Canvas .center-fill: centred in a box at least 520 tall.  -->
    <Grid MinHeight="520">
        <controls:EmptyState
            VerticalAlignment="Center"
            Glyph="{x:Bind Glyph, Mode=OneWay}"
            IsPageLevel="True"
            Message="{x:Bind Message, Mode=OneWay}"
            Title="No workspace open">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Click="OnNewWorkspace" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:StudioIcons.Add}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="New workspace" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenFolder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:StudioIcons.OpenFolder}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="Open folder…" />
                        </StackPanel>
                    </Button>
                    <!--  Clone from Git has no designed flow (docs/open-questions.md): its link is shown, off.  -->
                    <HyperlinkButton
                        Content="Clone from Git…"
                        IsEnabled="False"
                        Visibility="{x:Bind ShowsClone, Mode=OneWay}" />
                </StackPanel>
                <InfoBar
                    x:Name="Problem"
                    MaxWidth="480"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="That folder didn’t open." />
            </StackPanel>
        </controls:EmptyState>
    </Grid>
</UserControl>
