<UserControl
    x:Class="DelphiModernizer.Studio.UI.Common.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel
        Padding="16,24"
        HorizontalAlignment="Center"
        Spacing="8">
        <FontIcon
            x:Name="Icon"
            Margin="0,0,0,4"
            HorizontalAlignment="Center"
            FontFamily="{StaticResource StudioIconsFontFamily}"
            FontSize="32"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Glyph="{x:Bind Glyph, Mode=OneWay}" />
        <TextBlock
            x:Name="Heading"
            HorizontalAlignment="Center"
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="Description"
            MaxWidth="296"
            HorizontalAlignment="Center"
            Style="{StaticResource SecondaryCaptionTextStyle}"
            Text="{x:Bind Message, Mode=OneWay}"
            TextAlignment="Center" />
        <ContentPresenter
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Content="{x:Bind Actions, Mode=OneWay}" />
    </StackPanel>
</UserControl>
