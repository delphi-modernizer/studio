<UserControl
    x:Class="DelphiModernizer.Studio.UI.Common.Controls.StatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Center"
    IsTabStop="False">

    <Border
        x:Name="Chip"
        Height="20"
        Padding="6,0,8,0"
        Background="{ThemeResource StatusPillNeutralBackground}"
        BorderBrush="{ThemeResource StatusPillOutline}"
        BorderThickness="1"
        CornerRadius="10">
        <VisualStateManager.VisualStateGroups>
            <!--  Setters, not code, pick the brushes: a ThemeResource in a setter follows this element's theme.  -->
            <VisualStateGroup x:Name="Tones">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="Chip.Background" Value="{ThemeResource StatusPillSuccessBackground}" />
                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource StatusPillToneOutline}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource StatusPillSuccessGlyph}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="Chip.Background" Value="{ThemeResource StatusPillCautionBackground}" />
                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource StatusPillToneOutline}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource StatusPillCautionGlyph}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="Chip.Background" Value="{ThemeResource StatusPillCriticalBackground}" />
                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource StatusPillToneOutline}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource StatusPillCriticalGlyph}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Attention">
                    <VisualState.Setters>
                        <Setter Target="Chip.Background" Value="{ThemeResource StatusPillAttentionBackground}" />
                        <Setter Target="Icon.Foreground" Value="{ThemeResource StatusPillAttentionForeground}" />
                        <Setter Target="Ring.Foreground" Value="{ThemeResource StatusPillAttentionForeground}" />
                        <Setter Target="Word.Foreground" Value="{ThemeResource StatusPillAttentionForeground}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <FontIcon
                x:Name="Icon"
                VerticalAlignment="Center"
                FontFamily="{StaticResource StudioIconsFontFamily}"
                FontSize="12"
                Foreground="{ThemeResource StatusPillNeutralGlyph}" />
            <ProgressRing
                x:Name="Ring"
                AutomationProperties.AccessibilityView="Raw"
                Width="12"
                Height="12"
                MinWidth="12"
                MinHeight="12"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />
            <!--  Trimmed to the cap height on top only: centred like Tight, with room for descenders.  -->
            <TextBlock
                x:Name="Word"
                AutomationProperties.AccessibilityView="Raw"
                VerticalAlignment="Center"
                Foreground="{ThemeResource StatusPillText}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextLineBounds="TrimToCapHeight" />
        </StackPanel>
    </Border>
</UserControl>
