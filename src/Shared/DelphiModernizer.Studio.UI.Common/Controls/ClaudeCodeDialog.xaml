<ContentDialog
    x:Class="DelphiModernizer.Studio.UI.Common.Controls.ClaudeCodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:DelphiModernizer.Studio.UI.Common.Icons"
    CloseButtonText="Not now"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16">
        <TextBlock
            x:Name="Lead"
            Style="{StaticResource BodyTextBlockStyle}"
            TextWrapping="Wrap" />
        <!--  Canvas .ibar.warn: the icon 16 from the top and 14 from the text, the text 14 above and below.  -->
        <Border
            Padding="16,0,4,0"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,16"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="{x:Bind icons:StudioIcons.WarningFilled}"
                    Style="{StaticResource IconStyle}" />
                <TextBlock
                    x:Name="EngineMessage"
                    Grid.Column="1"
                    Margin="0,14"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    LineHeight="20"
                    Style="{StaticResource MonoTextStyle}"
                    TextTrimming="None"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
        <!--  Canvas ClaudeDialog: a disc list with a hanging indent, 6 between items.  -->
        <StackPanel Spacing="6">
            <TextBlock
                Style="{StaticResource SecondaryCaptionTextStyle}"
                Text="What agents add when Claude Code is ready" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="•" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Workstream agents draft deliverables, each claim with an evidence link and a fact label."
                    TextWrapping="Wrap" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="•" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The Principal Architect agent combines the drafts and lists contradictions before each sign-off."
                    TextWrapping="Wrap" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="•" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="You still review every draft and approve every sign-off yourself."
                    TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
        <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}">
            Agents run on your own Claude Code installation and account; the studio stores no keys. Everything except
            agent runs keeps working without it.
        </TextBlock>
    </StackPanel>
</ContentDialog>
