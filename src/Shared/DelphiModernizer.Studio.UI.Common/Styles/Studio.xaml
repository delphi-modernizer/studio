<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Pill colours per theme: high contrast draws every pill as text in an outline, as the design's HC artboards do.  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="StatusPillNeutralBackground" ResourceKey="SystemFillColorSolidNeutralBackgroundBrush" />
            <StaticResource x:Key="StatusPillSuccessBackground" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
            <StaticResource x:Key="StatusPillCautionBackground" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="StatusPillCriticalBackground" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
            <StaticResource x:Key="StatusPillAttentionBackground" ResourceKey="SystemFillColorSolidAttentionBackgroundBrush" />
            <StaticResource x:Key="StatusPillOutline" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="StatusPillToneOutline" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="StatusPillText" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="StatusPillNeutralGlyph" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="StatusPillSuccessGlyph" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="StatusPillCautionGlyph" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="StatusPillCriticalGlyph" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="StatusPillAttentionForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="StatusPillNeutralBackground" ResourceKey="SystemFillColorSolidNeutralBackgroundBrush" />
            <StaticResource x:Key="StatusPillSuccessBackground" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
            <StaticResource x:Key="StatusPillCautionBackground" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="StatusPillCriticalBackground" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
            <StaticResource x:Key="StatusPillAttentionBackground" ResourceKey="SystemFillColorSolidAttentionBackgroundBrush" />
            <StaticResource x:Key="StatusPillOutline" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="StatusPillToneOutline" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="StatusPillText" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="StatusPillNeutralGlyph" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="StatusPillSuccessGlyph" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="StatusPillCautionGlyph" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="StatusPillCriticalGlyph" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="StatusPillAttentionForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="StatusPillNeutralBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="StatusPillSuccessBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="StatusPillCautionBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="StatusPillCriticalBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="StatusPillAttentionBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <SolidColorBrush x:Key="StatusPillOutline" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusPillToneOutline" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusPillText" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusPillNeutralGlyph" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusPillSuccessGlyph" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusPillCautionGlyph" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusPillCriticalGlyph" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusPillAttentionForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  The page frame (handoff notes): 24 top, 32 sides and bottom, content at most 1240 wide, left-aligned.  -->
    <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
    <x:Double x:Key="PageMaxWidth">1240</x:Double>
    <x:Double x:Key="PageHeaderSpacing">20</x:Double>

    <Style x:Key="PageContentStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="{StaticResource PageMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <Setter Property="Spacing" Value="{StaticResource PageHeaderSpacing}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style
        x:Key="SecondaryCaptionTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Paths, fingerprints, commits, commands and the document IDs people search for.  -->
    <Style x:Key="MonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  An outlined tag, such as a workspace's target platform: an outline and no colour, so it never reads as a state.  -->
    <Style x:Key="TagStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="Padding" Value="6,0,6,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--  A card whose rows reach its edges: the header and the rows carry their own padding.  -->
    <Style
        x:Key="FlushCardStyle"
        BasedOn="{StaticResource CardStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CardHeaderStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="16,8,8,8" />
        <Setter Property="ColumnSpacing" Value="8" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!--  Tables (handoff part 2): a 36 tall header row of captions, rows at least 44 tall, 12 between columns.  -->
    <Style x:Key="TableHeaderStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="TableHeaderTextStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="TableRowStyle"
        BasedOn="{StaticResource DefaultListViewItemStyle}"
        TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!--  The tile in an action card or a role: 40 square, the accent fill for the one primary action.  -->
    <Style x:Key="TileStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="AccentTileStyle"
        BasedOn="{StaticResource TileStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style
        x:Key="ActionCardStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

</ResourceDictionary>
